---
const marcas = [
  "French Avenue",
  "Armaf",
  "Lattafa",
  "Maison Alhambra",
  "Paris Corner",
  "Rave",
];

const rutaActual = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-main">
    <a href="/" class="brand" aria-label="Ir al inicio de Nuite Perfumes">
      <span class="logo-circle">
        <img src="/img/logo.png" alt="" width="64" height="64" />
      </span>
      <span class="brand-text">
        <strong>Nuit&eacute;</strong>
        <small>PERFUMES</small>
      </span>
    </a>

    <form class="header-search" data-catalog-search>
      <label class="sr-only" for="header-search-input">Buscar en el catálogo</label>
      <span aria-hidden="true" class="search-mark"></span>
      <input
        id="header-search-input"
        type="search"
        placeholder="¿Qué perfume estás buscando?"
        autocomplete="off"
      />
      <button type="submit">Buscar</button>
    </form>

    <div class="header-actions">
      <a
        href="https://instagram.com/nuiteperfumes"
        target="_blank"
        rel="noreferrer"
        class="quiet-link"
      >
        Instagram
      </a>
      <a
        href="https://wa.me/56935226409?text=Hola%20Nuite%2C%20necesito%20asesor%C3%ADa%20con%20un%20perfume"
        target="_blank"
        rel="noreferrer"
        class="contact-link"
      >
        Hablar por WhatsApp
      </a>
    </div>
  </div>

  <div class="nav-row">
    <nav class="menu" aria-label="Navegación principal">
      <a href="/" aria-current={rutaActual === "/" ? "page" : undefined}>Inicio</a>
      <a href="/perfumes" aria-current={rutaActual === "/perfumes" ? "page" : undefined}>Perfumes</a>

      <div class="dropdown" data-brand-dropdown>
        <button
          class:list={{ activo: rutaActual === "/marcas" }}
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          data-brand-toggle
        >
          Marcas <span aria-hidden="true">⌄</span>
        </button>
        <div class="dropdown-menu">
          <a href="/marcas">Ver todas las marcas</a>
          {marcas.map((marca) => (
            <a href={`/perfumes?marca=${encodeURIComponent(marca)}#catalogo`}>{marca}</a>
          ))}
        </div>
      </div>

      <a href="/favoritos" aria-current={rutaActual === "/favoritos" ? "page" : undefined}>Favoritos</a>
      <a href="/perfumes?genero=Hombre#catalogo">Hombre</a>
      <a href="/perfumes?genero=Mujer#catalogo">Mujer</a>
      <a href="/perfumes?genero=Unisex#catalogo">Unisex</a>
      <a href="/ofertas">Ofertas</a>
      <a href="/contacto">Contacto</a>
    </nav>
  </div>

  <div class="benefit-strip" aria-label="Información de compra">
    <span><i></i> Envíos a todo Chile</span>
    <span><i></i> Asesoría personalizada</span>
    <span><i></i> Compra directa por WhatsApp</span>
    <span><i></i> Stock actualizado</span>
  </div>
</header>

<script>
  document.querySelectorAll("[data-catalog-search]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const input = form.querySelector("input");
      const value = input?.value?.trim() || "";

      if (window.location.pathname !== "/perfumes") {
        window.location.href = `/perfumes?buscar=${encodeURIComponent(value)}#catalogo`;
        return;
      }

      window.dispatchEvent(new CustomEvent("nuite:buscar", { detail: value }));
      document.querySelector("#catalogo")?.scrollIntoView({ behavior: "smooth" });
    });
  });
  const siteHeader = document.querySelector(".site-header");
  const brandDropdown = document.querySelector("[data-brand-dropdown]");
  const brandToggle = document.querySelector("[data-brand-toggle]");
  const mobileBrands = window.matchMedia("(max-width: 620px)");

  function actualizarPosicionMarcasMobile() {
    if (!siteHeader || !mobileBrands.matches) return;
    const top = Math.ceil(siteHeader.getBoundingClientRect().bottom) - 1;
    document.documentElement.style.setProperty("--mobile-brands-top", `${top}px`);
  }

  function cerrarMarcasMobile() {
    brandDropdown?.classList.remove("dropdown-open");
    brandToggle?.setAttribute("aria-expanded", "false");
  }

  brandToggle?.addEventListener("click", () => {
    if (!mobileBrands.matches) return;

    actualizarPosicionMarcasMobile();
    const estaAbierto = brandDropdown?.classList.contains("dropdown-open");
    brandDropdown?.classList.toggle("dropdown-open", !estaAbierto);
    brandToggle.setAttribute("aria-expanded", String(!estaAbierto));
  });

  document.addEventListener("click", (event) => {
    if (!mobileBrands.matches || !brandDropdown?.classList.contains("dropdown-open")) return;
    if (brandDropdown.contains(event.target)) return;
    cerrarMarcasMobile();
  });

  window.addEventListener("resize", () => {
    actualizarPosicionMarcasMobile();
    if (!mobileBrands.matches) cerrarMarcasMobile();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    color: #fff;
    background: #070707;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.3);
  }

  .header-main {
    max-width: 1380px;
    min-height: 84px;
    margin: 0 auto;
    padding: 12px 28px;
    display: grid;
    grid-template-columns: auto minmax(340px, 1fr) auto;
    align-items: center;
    gap: 34px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
  }

  .logo-circle {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: #050505;
  }

  .logo-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-text strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 31px;
    letter-spacing: -0.04em;
  }

  .brand-text small {
    margin-top: 5px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.32em;
  }

  .header-search {
    height: 50px;
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 5px 6px 5px 18px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    background: #171717;
  }

  .search-mark {
    position: relative;
    width: 14px;
    height: 14px;
    border: 2px solid var(--gold);
    border-radius: 50%;
  }

  .search-mark::after {
    content: "";
    position: absolute;
    right: -5px;
    bottom: -3px;
    width: 7px;
    height: 2px;
    background: var(--gold);
    transform: rotate(45deg);
    transform-origin: left center;
  }

  .header-search input {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
  }

  .header-search button {
    height: 38px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: var(--gold);
    color: #080808;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-actions a {
    min-height: 42px;
    padding: 0 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
  }

  .quiet-link {
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .contact-link {
    background: var(--gold);
    color: #080808;
  }

  .nav-row {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #0d0d0d;
  }

  .menu {
    max-width: 1380px;
    min-height: 47px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 28px;
    color: #fff;
    font-size: 13px;
    font-weight: 850;
  }

  .menu > a,
  .dropdown > button {
    height: 47px;
    display: inline-flex;
    align-items: center;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .menu > a:hover,
  .menu > a[aria-current="page"],
  .dropdown > button.activo,
  .dropdown > button:hover {
    border-bottom-color: var(--gold);
  }

  .dropdown {
    position: relative;
  }

  .dropdown button span {
    margin-left: 7px;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% - 1px);
    left: -18px;
    width: 240px;
    padding: 12px;
    display: none;
    border: 1px solid #292929;
    border-radius: 0 0 18px 18px;
    background: #111;
    color: #fff;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.25);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: grid;
  }

  .dropdown-menu a {
    padding: 11px 13px;
    border-radius: 10px;
    font-size: 13px;
  }

  .dropdown-menu a:hover {
    background: var(--gold);
    color: #080808;
  }

  .benefit-strip {
    min-height: 38px;
    padding: 8px 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 64px;
    overflow-x: auto;
    background: #171717;
    color: #d0d0d0;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .benefit-strip::-webkit-scrollbar {
    display: none;
  }

  .benefit-strip span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .benefit-strip i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--gold);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1120px) {
    .header-main {
      grid-template-columns: auto 1fr;
      gap: 18px;
    }

    .header-search {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .header-actions {
      justify-self: end;
    }

    .nav-row {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-row::-webkit-scrollbar {
      display: none;
    }

    .menu {
      width: max-content;
      min-width: 100%;
    }

    .benefit-strip {
      justify-content: flex-start;
      gap: 38px;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      position: relative;
    }

    .header-main {
      min-height: auto;
      padding: 10px 16px 12px;
      gap: 12px;
    }

    .logo-circle {
      width: 44px;
      height: 44px;
    }

    .brand-text strong {
      font-size: 24px;
    }

    .quiet-link {
      display: none !important;
    }

    .header-actions a {
      min-height: 38px;
      padding: 0 13px;
      font-size: 10px;
    }

    .header-search {
      height: 48px;
      padding-left: 16px;
    }

    .header-search button {
      padding: 0 15px;
    }

    .menu {
      gap: 22px;
      padding: 0 16px;
      font-size: 12px;
    }

    .dropdown {
      position: static;
    }

    .dropdown-menu {
      position: fixed;
      top: var(--mobile-brands-top, 176px);
      right: 12px;
      left: 12px;
      z-index: 140;
      width: auto;
      max-height: min(56vh, 420px);
      overflow-y: auto;
      padding: 12px;
      display: none;
      gap: 4px;
      border-radius: 18px;
      box-shadow: 0 26px 70px rgba(0, 0, 0, 0.68), 0 0 0 1px rgba(212, 175, 55, 0.16);
    }

    .dropdown:not(.dropdown-open) .dropdown-menu {
      display: none !important;
    }

    .dropdown.dropdown-open .dropdown-menu {
      display: grid !important;
    }

    .dropdown.dropdown-open > button {
      color: var(--gold2);
      border-bottom-color: var(--gold2);
    }

    .dropdown-menu a {
      min-height: 42px;
      display: flex;
      align-items: center;
    }
    .benefit-strip {
      padding-inline: 16px;
      gap: 30px;
    }
  }

  /* Nuite luxury polish */
  .site-header {
    background: rgba(3, 3, 3, 0.96);
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    color: var(--champagne);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.48);
  }

  .logo-circle {
    border: 1px solid rgba(212, 175, 55, 0.46);
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.08);
  }

  .brand-text strong,
  .brand-text small {
    color: var(--champagne);
  }

  .header-search,
  .nav-row,
  .benefit-strip,
  .dropdown-menu {
    border-color: rgba(212, 175, 55, 0.18);
    background: rgba(8, 8, 7, 0.96);
  }

  .header-search input {
    color: var(--champagne);
  }

  .header-search input::placeholder {
    color: #8f856f;
  }

  .header-search button,
  .contact-link {
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
  }

  .quiet-link {
    border-color: rgba(212, 175, 55, 0.24);
    color: var(--champagne);
  }

  .menu > a:hover,
  .menu > a[aria-current="page"],
  .dropdown > button.activo,
  .dropdown > button:hover {
    color: var(--gold2);
    border-bottom-color: var(--gold2);
  }

  .dropdown-menu a:hover {
    background: linear-gradient(135deg, var(--gold2), var(--gold));
    color: #050505;
  }

  .benefit-strip {
    color: #c5baa2;
  }

  .search-mark {
    border-color: var(--gold2);
    background: transparent;
  }

  .benefit-strip i,
  .search-mark::after {
    background-color: var(--gold2);
  }
</style>
