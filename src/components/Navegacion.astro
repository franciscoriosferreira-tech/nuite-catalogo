---
const rutaActual = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-main">
    <a href="/" class="brand" aria-label="Ir al inicio de Nuite Perfumes">
      <span class="logo-circle">
        <img src="/img/logo.png" alt="" width="64" height="64" />
      </span>
      <span class="brand-text">
        <strong>Nuit&eacute;</strong>
        <small>PERFUMES</small>
      </span>
    </a>


    <div class="header-actions">
      <a
        href="https://instagram.com/nuiteperfumes"
        target="_blank"
        rel="noreferrer"
        class="quiet-link"
      >
        Instagram
      </a>
      <a
        href="https://wa.me/56935226409?text=Hola%20Nuite%2C%20necesito%20asesor%C3%ADa%20con%20un%20perfume"
        target="_blank"
        rel="noreferrer"
        class="contact-link"
      >
        <span class="desktop-label">Hablar por WhatsApp</span>
        <span class="mobile-label">WhatsApp</span>
      </a>
      <button class="cart-link" type="button" data-cart-open aria-label="Abrir carrito de compras">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 7H6.2"></path>
          <circle cx="9" cy="20" r="1.25" fill="currentColor" stroke="none"></circle>
          <circle cx="18" cy="20" r="1.25" fill="currentColor" stroke="none"></circle>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-row">
    <nav class="menu" aria-label="Navegación principal">
      <a href="/" aria-current={rutaActual === "/" ? "page" : undefined}>Inicio</a>

      <a href="/marcas" aria-current={rutaActual === "/marcas" ? "page" : undefined}>Marcas</a>

      <a href="/ofertas" aria-current={rutaActual === "/ofertas" ? "page" : undefined}>Ofertas</a>
      <a href="/sorteos" aria-current={rutaActual === "/sorteos" ? "page" : undefined}>Sorteos</a>
      <a href="/contacto" aria-current={rutaActual === "/contacto" ? "page" : undefined}>Contacto</a>
    </nav>
  </div>

  <div class="benefit-strip" aria-label="Información de compra">
    <div class="benefit-track">
      <div class="benefit-group">
        <span><i></i> Envíos a todo Chile</span>
        <span><i></i> Asesoría personalizada</span>
        <span><i></i> Compra directa por WhatsApp</span>
        <span><i></i> Stock actualizado</span>
      </div>
      <div class="benefit-group" aria-hidden="true">
        <span><i></i> Envíos a todo Chile</span>
        <span><i></i> Asesoría personalizada</span>
        <span><i></i> Compra directa por WhatsApp</span>
        <span><i></i> Stock actualizado</span>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    background: rgba(3, 3, 3, 0.97);
    color: var(--champagne);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.46);
  }

  .header-main {
    max-width: 1380px;
    min-height: 92px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--champagne);
  }

  .logo-circle {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.46);
    border-radius: 50%;
    background: #050505;
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.08);
  }

  .logo-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-text strong {
    color: var(--champagne);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 34px;
    letter-spacing: 0;
  }

  .brand-text small {
    margin-top: 6px;
    color: var(--champagne);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .header-actions a,
  .cart-link {
    min-height: 48px;
    padding: 0 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 900;
    white-space: nowrap;
  }

  .cart-link {
    width: 48px;
    padding: 0;
    border: 1px solid rgba(212, 175, 55, 0.35);
    background: #0b0b09;
    color: var(--gold2);
    cursor: pointer;
  }

  .cart-link svg {
    width: 24px;
    height: 24px;
    flex: none;
  }

  .quiet-link {
    border: 1px solid rgba(212, 175, 55, 0.24);
    color: var(--champagne);
  }

  .mobile-label {
    display: none;
  }

  .contact-link {
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
  }

  .nav-row {
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    border-bottom: 1px solid rgba(212, 175, 55, 0.14);
    background: rgba(8, 8, 7, 0.96);
  }

  .menu {
    max-width: 1380px;
    min-height: 52px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    gap: 34px;
    color: #fff;
    font-size: 14px;
    font-weight: 850;
  }

  .menu > a {
    height: 52px;
    display: inline-flex;
    align-items: center;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .menu > a:hover,
  .menu > a[aria-current="page"] {
    border-bottom-color: var(--gold2);
    color: var(--gold2);
  }

  .benefit-strip {
    --ticker-gap: 54px;
    min-height: 36px;
    padding: 8px 0;
    overflow: hidden;
    background: rgba(8, 8, 7, 0.96);
    color: #c5baa2;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .benefit-track {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .benefit-group {
    box-sizing: border-box;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-around;
    gap: var(--ticker-gap);
    min-width: 100vw;
    padding: 0 18px;
  }

  .benefit-track {
    animation: benefit-marquee 30s linear infinite;
    will-change: transform;
  }

  .benefit-group span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .benefit-strip i {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--gold2);
  }

  @keyframes benefit-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 820px) {
    .benefit-strip {
      --ticker-gap: 34px;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      position: relative;
    }

    .header-main {
      min-height: 66px;
      padding: 9px 10px;
      gap: 8px;
    }

    .logo-circle {
      width: 44px;
      height: 44px;
    }

    .brand {
      gap: 8px;
    }

    .brand-text strong {
      font-size: 22px;
    }

    .brand-text small {
      display: none;
    }

    .header-actions {
      gap: 5px;
    }

    .header-actions a,
    .cart-link {
      min-height: 40px;
      padding: 0 8px;
      border-radius: 10px;
      font-size: 9px;
    }

    .cart-link {
      width: 40px;
      padding: 0;
    }

    .cart-link svg {
      width: 22px;
      height: 22px;
    }

    .desktop-label {
      display: none;
    }

    .mobile-label {
      display: inline;
    }

    .menu {
      width: 100%;
      min-height: 46px;
      padding: 0 10px;
      justify-content: space-between;
      gap: 8px;
      font-size: 11.5px;
    }

    .menu > a {
      height: 46px;
    }

    .benefit-strip {
      min-height: 33px;
      padding: 7px 0;
      font-size: 9.5px;
    }
  }

  @media (max-width: 390px) {
    .header-main {
      padding-inline: 8px;
    }

    .brand {
      gap: 6px;
    }

    .logo-circle {
      width: 40px;
      height: 40px;
    }

    .brand-text strong {
      font-size: 20px;
    }

    .header-actions a {
      padding-inline: 6px;
      font-size: 8.5px;
    }

    .menu {
      gap: 6px;
      font-size: 10.5px;
    }
  }

  @media (max-width: 350px) {
    .brand-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-track {
      animation-duration: 80s;
    }
  }
</style>
