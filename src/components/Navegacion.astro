---
const marcas = [
  "French Avenue",
  "Armaf",
  "Lattafa",
  "Maison Alhambra",
  "Paris Corner",
  "Rave",
];

const rutaActual = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-main">
    <a href="/" class="brand" aria-label="Ir al inicio de Nuite Perfumes">
      <span class="logo-circle">
        <img src="/img/logo.png" alt="" width="64" height="64" />
      </span>
      <span class="brand-text">
        <strong>Nuit&eacute;</strong>
        <small>PERFUMES</small>
      </span>
    </a>


    <div class="header-actions">
      <a
        href="https://instagram.com/nuiteperfumes"
        target="_blank"
        rel="noreferrer"
        class="quiet-link"
      >
        Instagram
      </a>
      <a
        href="https://wa.me/56935226409?text=Hola%20Nuite%2C%20necesito%20asesor%C3%ADa%20con%20un%20perfume"
        target="_blank"
        rel="noreferrer"
        class="contact-link"
      >
        <span class="desktop-label">Hablar por WhatsApp</span>
        <span class="mobile-label">WhatsApp</span>
      </a>
    </div>
  </div>

  <div class="nav-row">
    <nav class="menu" aria-label="Navegación principal">
      <a href="/" aria-current={rutaActual === "/" ? "page" : undefined}>Inicio</a>
      <a href="/perfumes" aria-current={rutaActual === "/perfumes" ? "page" : undefined}>Perfumes</a>

      <div class="dropdown" data-brand-dropdown>
        <button
          class:list={{ activo: rutaActual === "/marcas" }}
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          data-brand-toggle
        >
          Marcas <span aria-hidden="true">⌄</span>
        </button>
        <div class="dropdown-menu">
          <a href="/marcas">Ver todas las marcas</a>
          {marcas.map((marca) => (
            <a href={`/perfumes?marca=${encodeURIComponent(marca)}#catalogo`}>{marca}</a>
          ))}
        </div>
      </div>

      <a href="/ofertas" aria-current={rutaActual === "/ofertas" ? "page" : undefined}>Ofertas</a>
      <a href="/contacto" aria-current={rutaActual === "/contacto" ? "page" : undefined}>Contacto</a>
    </nav>
  </div>

  <div class="benefit-strip" aria-label="Información de compra">
    <span><i></i> Envíos a todo Chile</span>
    <span><i></i> Asesoría personalizada</span>
    <span><i></i> Compra directa por WhatsApp</span>
    <span><i></i> Stock actualizado</span>
  </div>
</header>

<script>
  const siteHeader = document.querySelector(".site-header");
  const brandDropdown = document.querySelector("[data-brand-dropdown]");
  const brandToggle = document.querySelector("[data-brand-toggle]");
  const mobileBrands = window.matchMedia("(max-width: 620px)");

  function actualizarPosicionMarcasMobile() {
    if (!siteHeader || !mobileBrands.matches) return;
    const top = Math.ceil(siteHeader.getBoundingClientRect().bottom) - 1;
    document.documentElement.style.setProperty("--mobile-brands-top", `${top}px`);
  }

  function cerrarMarcasMobile() {
    brandDropdown?.classList.remove("dropdown-open");
    brandToggle?.setAttribute("aria-expanded", "false");
  }

  brandToggle?.addEventListener("click", () => {
    if (!mobileBrands.matches) return;

    actualizarPosicionMarcasMobile();
    const estaAbierto = brandDropdown?.classList.contains("dropdown-open");
    brandDropdown?.classList.toggle("dropdown-open", !estaAbierto);
    brandToggle.setAttribute("aria-expanded", String(!estaAbierto));
  });

  document.addEventListener("click", (event) => {
    if (!mobileBrands.matches || !brandDropdown?.classList.contains("dropdown-open")) return;
    if (brandDropdown.contains(event.target)) return;
    cerrarMarcasMobile();
  });

  window.addEventListener("resize", () => {
    actualizarPosicionMarcasMobile();
    if (!mobileBrands.matches) cerrarMarcasMobile();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    background: rgba(3, 3, 3, 0.97);
    color: var(--champagne);
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.46);
  }

  .header-main {
    max-width: 1380px;
    min-height: 76px;
    margin: 0 auto;
    padding: 10px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--champagne);
  }

  .logo-circle {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.46);
    border-radius: 50%;
    background: #050505;
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.08);
  }

  .logo-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-text strong {
    color: var(--champagne);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 29px;
    letter-spacing: 0;
  }

  .brand-text small {
    margin-top: 5px;
    color: var(--champagne);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .header-actions a {
    min-height: 40px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
  }

  .quiet-link {
    border: 1px solid rgba(212, 175, 55, 0.24);
    color: var(--champagne);
  }

  .mobile-label {
    display: none;
  }

  .contact-link {
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
  }

  .nav-row {
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    border-bottom: 1px solid rgba(212, 175, 55, 0.14);
    background: rgba(8, 8, 7, 0.96);
  }

  .menu {
    max-width: 1380px;
    min-height: 45px;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 28px;
    color: #fff;
    font-size: 13px;
    font-weight: 850;
  }

  .menu > a,
  .dropdown > button {
    height: 45px;
    display: inline-flex;
    align-items: center;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .menu > a:hover,
  .menu > a[aria-current="page"],
  .dropdown > button.activo,
  .dropdown > button:hover {
    border-bottom-color: var(--gold2);
    color: var(--gold2);
  }

  .dropdown {
    position: relative;
  }

  .dropdown button span {
    margin-left: 7px;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% - 1px);
    left: -18px;
    width: 240px;
    padding: 12px;
    display: none;
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: 0 0 16px 16px;
    background: rgba(8, 8, 7, 0.98);
    color: #fff;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.42);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    display: grid;
  }

  .dropdown-menu a {
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 13px;
  }

  .dropdown-menu a:hover {
    background: linear-gradient(135deg, var(--gold2), var(--gold));
    color: #050505;
  }

  .benefit-strip {
    min-height: 34px;
    padding: 7px 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 54px;
    overflow-x: auto;
    background: rgba(8, 8, 7, 0.96);
    color: #c5baa2;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .benefit-strip::-webkit-scrollbar {
    display: none;
  }

  .benefit-strip span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .benefit-strip i {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--gold2);
  }

  @media (max-width: 820px) {
    .benefit-strip {
      justify-content: flex-start;
      gap: 34px;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      position: relative;
    }

    .header-main {
      min-height: 62px;
      padding: 8px 12px;
      gap: 10px;
    }

    .logo-circle {
      width: 42px;
      height: 42px;
    }

    .brand {
      gap: 9px;
    }

    .brand-text strong {
      font-size: 23px;
    }

    .brand-text small {
      font-size: 8px;
    }

    .header-actions {
      gap: 6px;
    }

    .header-actions a {
      min-height: 37px;
      padding: 0 9px;
      border-radius: 10px;
      font-size: 9px;
    }

    .desktop-label {
      display: none;
    }

    .mobile-label {
      display: inline;
    }

    .menu {
      width: 100%;
      min-height: 42px;
      padding: 0 12px;
      justify-content: space-between;
      gap: 8px;
      font-size: 11px;
    }

    .menu > a,
    .dropdown > button {
      height: 42px;
    }

    .dropdown {
      position: static;
    }

    .dropdown-menu {
      position: fixed;
      top: var(--mobile-brands-top, 138px);
      right: 12px;
      left: 12px;
      z-index: 140;
      width: auto;
      max-height: min(56vh, 420px);
      overflow-y: auto;
      padding: 10px;
      display: none;
      gap: 3px;
      border-radius: 15px;
      box-shadow: 0 26px 70px rgba(0, 0, 0, 0.68), 0 0 0 1px rgba(212, 175, 55, 0.16);
    }

    .dropdown:not(.dropdown-open) .dropdown-menu {
      display: none !important;
    }

    .dropdown.dropdown-open .dropdown-menu {
      display: grid !important;
    }

    .dropdown.dropdown-open > button {
      border-bottom-color: var(--gold2);
      color: var(--gold2);
    }

    .dropdown-menu a {
      min-height: 40px;
      display: flex;
      align-items: center;
    }

    .benefit-strip {
      min-height: 31px;
      padding: 6px 12px;
      gap: 28px;
      font-size: 9px;
    }
  }
</style>
