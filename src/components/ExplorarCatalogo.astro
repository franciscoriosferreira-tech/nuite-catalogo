---
const { vista = "favoritos" } = Astro.props;

const contenido = vista === "marcas"
  ? {
      kicker: "Casas destacadas",
      titulo: "Explora nuestras marcas",
      texto: "Descubre las casas con mayor variedad disponible y entra directamente a sus perfumes.",
    }
  : {
      kicker: "Selección Nuite",
      titulo: "Favoritos del momento",
      texto: "Una selección de fragancias disponibles para encontrar inspiración sin recorrer todo el catálogo.",
    };
---

<main class="explore-page" data-explore-root data-vista={vista}>
  <section class="explore-hero">
    <div class="explore-wrap">
      <p>{contenido.kicker}</p>
      <h1>{contenido.titulo}</h1>
      <span>{contenido.texto}</span>
    </div>
  </section>

  <section class="explore-content">
    <div class="explore-wrap">
      <div class="loading-grid" data-loading aria-label="Cargando contenido">
        {Array.from({ length: vista === "marcas" ? 3 : 8 }).map(() => (
          <div class="loading-card" aria-hidden="true"></div>
        ))}
      </div>
      <div class:list={["favorite-grid", { hidden: vista !== "favoritos" }]} data-favorites></div>
      <div class:list={["brands-grid", { hidden: vista !== "marcas" }]} data-brands></div>
      <p class="explore-error hidden" data-error>
        No pudimos cargar esta selección. Inténtalo nuevamente en unos minutos.
      </p>
    </div>
  </section>
</main>

<script>
  import {
    PERFUME_PUBLIC_FIELDS,
    aplicarCorreccionPerfume,
  } from "../data/perfumeCorrections";

  const SUPABASE_URL = "https://anawpjjrtxzutillpnoz.supabase.co";
  const SUPABASE_KEY = "sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ";
  const root = document.querySelector("[data-explore-root]");
  const vista = root?.dataset.vista || "favoritos";
  const loading = root?.querySelector("[data-loading]");
  const favoriteGrid = root?.querySelector("[data-favorites]");
  const brandsGrid = root?.querySelector("[data-brands]");
  const errorMessage = root?.querySelector("[data-error]");

  const formatPrice = (price) =>
    new Intl.NumberFormat("es-CL", {
      style: "currency",
      currency: "CLP",
      maximumFractionDigits: 0,
    }).format(price || 0);

  const imagenPerfume = (perfume) =>
    perfume.imagen_url ||
    (perfume.imagen_local ? `/${perfume.imagen_local}` : "/img/logo.png");

  const detallePerfumeUrl = (perfume) =>
    perfume.id
      ? `/perfume?id=${encodeURIComponent(perfume.id)}`
      : `/perfume?slug=${encodeURIComponent(perfume.slug || "")}`;

  function renderFavorites(perfumes) {
    const favoritos = [...perfumes]
      .sort((a, b) => Number(b.stock || 0) - Number(a.stock || 0))
      .slice(0, 12);

    favoriteGrid.innerHTML = favoritos.map((perfume) => `
      <a class="favorite-card" href="${detallePerfumeUrl(perfume)}">
        <div class="favorite-image">
          <img
            src="${imagenPerfume(perfume)}"
            alt="${perfume.nombre || "Perfume"}"
            width="420"
            height="520"
            loading="lazy"
            decoding="async"
          />
          <span>${perfume.genero || "Unisex"}</span>
        </div>
        <div class="favorite-copy">
          <small>${perfume.marca || "Nuite Perfumes"}</small>
          <strong>${perfume.nombre || "Perfume"}</strong>
          <b>${formatPrice(perfume.precio || 0)}</b>
          <em>Ver perfume →</em>
        </div>
      </a>
    `).join("");
  }

  function renderBrands(perfumes) {
    const groups = perfumes.reduce((result, perfume) => {
      if (!perfume.marca) return result;
      result[perfume.marca] ||= [];
      result[perfume.marca].push(perfume);
      return result;
    }, {});

    const brands = Object.entries(groups)
      .sort(([, productsA], [, productsB]) => productsB.length - productsA.length);

    brandsGrid.innerHTML = brands.map(([brand, products], index) => {
      const samples = products.slice(0, 3);
      return `
        <a class="brand-card brand-card-${(index % 3) + 1}" href="/perfumes?marca=${encodeURIComponent(brand)}#catalogo">
          <div class="brand-products">
            ${samples.map((product, position) => `
              <img
                class="brand-product brand-product-${position + 1}"
                src="${imagenPerfume(product)}"
                alt=""
                width="420"
                height="520"
                loading="lazy"
                decoding="async"
              />
            `).join("")}
          </div>
          <div class="brand-copy">
            <small>Descubre</small>
            <strong>${brand}</strong>
            <span>${products.length} perfumes disponibles</span>
            <b>Ver perfumes →</b>
          </div>
        </a>
      `;
    }).join("");
  }

  async function loadPerfumes() {
    const params = new URLSearchParams({
      select: PERFUME_PUBLIC_FIELDS,
      activo: "eq.true",
      stock: "gt.0",
      order: "nombre.asc",
    });

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/perfumes?${params}`, {
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
        },
      });

      if (!response.ok) throw new Error(`Supabase respondió ${response.status}`);
      const perfumes = (await response.json()).map(aplicarCorreccionPerfume);
      loading?.classList.add("hidden");

      if (vista === "marcas") renderBrands(perfumes);
      else renderFavorites(perfumes);
    } catch (error) {
      console.error(error);
      loading?.classList.add("hidden");
      errorMessage?.classList.remove("hidden");
    }
  }

  loadPerfumes();
</script>

<style is:global>
  .explore-page {
    min-height: 100vh;
    background: #050505;
    color: #fff;
  }

  .explore-wrap {
    max-width: 1380px;
    margin: 0 auto;
  }

  .explore-hero {
    padding: 86px 24px 72px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    background:
      radial-gradient(circle at 78% 20%, rgba(255, 196, 0, 0.14), transparent 28%),
      #080808;
  }

  .explore-hero p {
    margin: 0 0 16px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .explore-hero h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(48px, 6vw, 82px);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .explore-hero span {
    max-width: 700px;
    margin-top: 23px;
    display: block;
    color: #a8a8a8;
    font-size: 17px;
    line-height: 1.7;
  }

  .explore-content {
    padding: 62px 24px 92px;
  }

  .favorite-grid,
  .loading-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .favorite-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: #151515;
    color: #fff;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .favorite-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 196, 0, 0.6);
  }

  .favorite-image {
    position: relative;
    height: 330px;
    background: #fff;
  }

  .favorite-image img {
    width: 100%;
    height: 100%;
    padding: 20px;
    object-fit: contain;
  }

  .favorite-image span {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    background: #080808;
    color: var(--gold);
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .favorite-copy {
    min-height: 180px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .favorite-copy small,
  .brand-copy small {
    color: var(--gold);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .favorite-copy strong {
    margin-top: 8px;
    font-size: 18px;
    line-height: 1.3;
  }

  .favorite-copy b {
    margin-top: 12px;
    font-size: 19px;
  }

  .favorite-copy em {
    margin-top: auto;
    padding-top: 18px;
    color: #a7a7a7;
    font-size: 11px;
    font-style: normal;
    font-weight: 900;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .brand-card {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 30px;
    background:
      radial-gradient(circle at 50% 32%, rgba(255, 196, 0, 0.21), transparent 35%),
      linear-gradient(150deg, #241d08, #0e0e0e 62%);
    color: #fff;
  }

  .brand-card-2 {
    background:
      radial-gradient(circle at 50% 32%, rgba(255, 216, 77, 0.15), transparent 35%),
      linear-gradient(150deg, #272310, #0e0e0e 62%);
  }

  .brand-card-3 {
    background:
      radial-gradient(circle at 50% 32%, rgba(183, 141, 0, 0.23), transparent 35%),
      linear-gradient(150deg, #201a0b, #0e0e0e 62%);
  }

  .brand-products {
    position: relative;
    height: 325px;
    margin: 22px 18px 0;
  }

  .brand-product {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 54%;
    height: 88%;
    padding: 8px;
    border-radius: 20px;
    background: #fff;
    object-fit: contain;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
    transform: translateX(-50%);
  }

  .brand-product-1 { z-index: 3; }

  .brand-product-2,
  .brand-product-3 {
    bottom: 14px;
    width: 43%;
    height: 72%;
    opacity: 0.82;
  }

  .brand-product-2 {
    left: 25%;
    transform: translateX(-50%) rotate(-8deg);
  }

  .brand-product-3 {
    left: 75%;
    transform: translateX(-50%) rotate(8deg);
  }

  .brand-copy {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    padding: 18px 20px;
    display: grid;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(5, 5, 5, 0.94);
  }

  .brand-copy strong {
    margin-top: 5px;
    font-size: 25px;
  }

  .brand-copy span {
    margin-top: 4px;
    color: #929292;
    font-size: 11px;
  }

  .brand-copy b {
    margin-top: 15px;
    color: var(--gold);
    font-size: 11px;
  }

  .loading-card {
    min-height: 450px;
    border-radius: 24px;
    background: linear-gradient(100deg, #141414 20%, #222 40%, #141414 60%);
    background-size: 200% 100%;
    animation: loading 1.2s ease-in-out infinite;
  }

  .explore-error {
    padding: 26px;
    border: 1px solid rgba(255, 196, 0, 0.35);
    border-radius: 20px;
    background: #151515;
    color: #c8c8c8;
  }

  .hidden { display: none !important; }

  @keyframes loading {
    to { background-position: -200% 0; }
  }

  @media (max-width: 1050px) {
    .favorite-grid,
    .loading-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .brands-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .explore-hero {
      padding: 58px 16px 52px;
    }

    .explore-content {
      padding: 36px 16px 68px;
    }

    .favorite-grid,
    .loading-grid,
    .brands-grid {
      grid-template-columns: 1fr;
    }

    .favorite-image {
      height: 310px;
    }

    .brand-card {
      min-height: 480px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorite-card { transition: none; }
    .loading-card { animation: none; }
  }

  /* Nuite luxury polish */
  .explore-page,
  .explore-hero {
    background:
      linear-gradient(180deg, #030303 0%, #090805 52%, #020202 100%);
    color: var(--champagne);
  }

  .explore-hero {
    border-color: rgba(212, 175, 55, 0.18);
  }

  .explore-hero p,
  .favorite-copy small,
  .brand-copy small,
  .brand-copy b {
    color: var(--gold2);
  }

  .explore-hero h1,
  .favorite-copy strong,
  .brand-copy strong {
    color: var(--champagne);
  }

  .explore-hero span,
  .favorite-copy em,
  .brand-copy span {
    color: #bfb49b;
  }

  .favorite-card,
  .brand-card,
  .brand-card-2,
  .brand-card-3,
  .explore-error {
    border-color: rgba(212, 175, 55, 0.22);
    background:
      linear-gradient(150deg, rgba(212, 175, 55, 0.16), transparent 38%),
      linear-gradient(180deg, #16130c 0%, #070707 70%);
    box-shadow: 0 24px 76px rgba(0, 0, 0, 0.48);
  }

  .favorite-card:hover,
  .brand-card:hover {
    border-color: rgba(241, 216, 137, 0.58);
    box-shadow: 0 30px 88px rgba(0, 0, 0, 0.54), 0 0 34px rgba(212, 175, 55, 0.12);
  }

  .favorite-image,
  .brand-product {
    background: linear-gradient(145deg, #efe3c4, #b89539 48%, #11100c);
  }

  .favorite-image span,
  .brand-copy {
    border: 1px solid rgba(212, 175, 55, 0.2);
    background: rgba(5, 5, 5, 0.92);
  }

  .favorite-copy b {
    color: var(--gold2);
  }

  .loading-card {
    background: linear-gradient(100deg, #11100c 20%, #2b2412 40%, #11100c 60%);
    background-size: 200% 100%;
  }
</style>
