---
const { vista = "favoritos" } = Astro.props;

const contenido = vista === "marcas"
  ? {
      kicker: "Perfumería árabe",
      titulo: "Todas las marcas",
      texto: "Elige una casa y descubre sus fragancias disponibles.",
    }
  : {
      kicker: "Selección Nuite",
      titulo: "Favoritos del momento",
      texto: "Una selección de fragancias disponibles para encontrar inspiración sin recorrer todo el catálogo.",
    };
---

<main class="explore-page" data-explore-root data-vista={vista}>
  <section class="explore-hero">
    <div class="explore-wrap">
      <p>{contenido.kicker}</p>
      <h1>{contenido.titulo}</h1>
      <span>{contenido.texto}</span>
    </div>
  </section>

  <section class="explore-content">
    <div class="explore-wrap">
      <div class="loading-grid" data-loading aria-label="Cargando contenido">
        {Array.from({ length: vista === "marcas" ? 12 : 8 }).map(() => (
          <div class="loading-card" aria-hidden="true"></div>
        ))}
      </div>
      <div class:list={["favorite-grid", { hidden: vista !== "favoritos" }]} data-favorites></div>
      <div class:list={["brands-grid", { hidden: vista !== "marcas" }]} data-brands></div>
      <p class="explore-error hidden" data-error>
        No pudimos cargar esta selección. Inténtalo nuevamente en unos minutos.
      </p>
    </div>
  </section>
</main>

<script>
  import {
    PERFUME_PUBLIC_FIELDS,
    aplicarCorreccionPerfume,
  } from "../data/perfumeCorrections";

  const SUPABASE_URL = "https://anawpjjrtxzutillpnoz.supabase.co";
  const SUPABASE_KEY = "sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ";
  const root = document.querySelector("[data-explore-root]");
  const vista = root?.dataset.vista || "favoritos";
  const loading = root?.querySelector("[data-loading]");
  const favoriteGrid = root?.querySelector("[data-favorites]");
  const brandsGrid = root?.querySelector("[data-brands]");
  const errorMessage = root?.querySelector("[data-error]");

  const formatPrice = (price) =>
    new Intl.NumberFormat("es-CL", {
      style: "currency",
      currency: "CLP",
      maximumFractionDigits: 0,
    }).format(price || 0);

  const imagenPerfume = (perfume) =>
    perfume.imagen_url ||
    (perfume.imagen_local ? `/${perfume.imagen_local}` : "/img/logo.png");

  const detallePerfumeUrl = (perfume) =>
    perfume.id
      ? `/perfume?id=${encodeURIComponent(perfume.id)}`
      : `/perfume?slug=${encodeURIComponent(perfume.slug || "")}`;

  const brandLogos = {
    afnan: "/img/brands/afnan.webp",
    armaf: "/img/brands/armaf.png",
    asdaaf: "/img/brands/asdaaf.webp",
    "dumont paris": "/img/brands/dumont.png",
    "fragance world": "/img/brands/fragrance-world.png",
    "fragrance world": "/img/brands/fragrance-world.png",
    lattafa: "/img/brands/lattafa.jpg",
    "maison alhambra": "/img/brands/maison-alhambra.webp",
    "paris corner": "/img/brands/paris-corner.png",
    rasasi: "/img/brands/rasasi.png",
    rayhaan: "/img/brands/rayhaan.webp",
    risala: "/img/brands/risala.jpg",
    tubbees: "/img/brands/tubbees.jpg",
  };

  const normalizarMarca = (brand) => String(brand || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();

  function renderFavorites(perfumes) {
    const favoritos = [...perfumes]
      .sort((a, b) => Number(b.stock || 0) - Number(a.stock || 0))
      .slice(0, 12);

    favoriteGrid.innerHTML = favoritos.map((perfume) => `
      <a class="favorite-card" href="${detallePerfumeUrl(perfume)}">
        <div class="favorite-image">
          <img
            src="${imagenPerfume(perfume)}"
            alt="${perfume.nombre || "Perfume"}"
            width="420"
            height="520"
            loading="lazy"
            decoding="async"
          />
          <span>${perfume.genero || "Unisex"}</span>
        </div>
        <div class="favorite-copy">
          <small>${perfume.marca || "Nuite Perfumes"}</small>
          <strong>${perfume.nombre || "Perfume"}</strong>
          <b>${formatPrice(perfume.precio || 0)}</b>
          <em>Ver perfume →</em>
        </div>
      </a>
    `).join("");
  }

  function renderBrands(perfumes) {
    const groups = perfumes.reduce((result, perfume) => {
      if (!perfume.marca) return result;
      result[perfume.marca] ||= [];
      result[perfume.marca].push(perfume);
      return result;
    }, {});

    const brands = Object.entries(groups)
      .sort(([, productsA], [, productsB]) => productsB.length - productsA.length);

    brandsGrid.innerHTML = brands.map(([brand, products]) => {
      const logo = brandLogos[normalizarMarca(brand)];
      const countLabel = products.length === 1
        ? "1 perfume disponible"
        : `${products.length} perfumes disponibles`;

      return `
        <a class="brand-card" href="/?marca=${encodeURIComponent(brand)}#catalogo">
          <div class="brand-logo-wrap">
            ${logo
              ? `<img class="brand-logo" src="${logo}" alt="Logo de ${brand}" loading="lazy" decoding="async" />`
              : `<span class="brand-monogram" aria-hidden="true">${brand.slice(0, 1)}</span>`}
          </div>
          <div class="brand-copy">
            <small>Casa de perfumería</small>
            <strong>${brand}</strong>
            <span>${countLabel}</span>
            <b>Explorar fragancias →</b>
          </div>
        </a>
      `;
    }).join("");
  }

  async function loadPerfumes() {
    const params = new URLSearchParams({
      select: PERFUME_PUBLIC_FIELDS,
      activo: "eq.true",
      stock: "gt.0",
      order: "nombre.asc",
    });

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/perfumes?${params}`, {
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
        },
      });

      if (!response.ok) throw new Error(`Supabase respondió ${response.status}`);
      const perfumes = (await response.json()).map(aplicarCorreccionPerfume);
      loading?.classList.add("hidden");

      if (vista === "marcas") renderBrands(perfumes);
      else renderFavorites(perfumes);
    } catch (error) {
      console.error(error);
      loading?.classList.add("hidden");
      errorMessage?.classList.remove("hidden");
    }
  }

  loadPerfumes();
</script>

<style is:global>
  .explore-page {
    min-height: 100vh;
    background: #050505;
    color: #fff;
  }

  .explore-wrap {
    max-width: 1380px;
    margin: 0 auto;
  }

  .explore-hero {
    padding: 56px 24px 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    background:
      radial-gradient(circle at 78% 20%, rgba(255, 196, 0, 0.14), transparent 28%),
      #080808;
  }

  .explore-hero p {
    margin: 0 0 16px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .explore-hero h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
    letter-spacing: 0;
  }

  .explore-hero span {
    max-width: 700px;
    margin-top: 16px;
    display: block;
    color: #a8a8a8;
    font-size: 15px;
    line-height: 1.55;
  }

  .explore-content {
    padding: 38px 24px 82px;
  }

  .favorite-grid,
  .loading-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .favorite-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: #151515;
    color: #fff;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .favorite-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 196, 0, 0.6);
  }

  .favorite-image {
    position: relative;
    height: 330px;
    background: #fff;
  }

  .favorite-image img {
    width: 100%;
    height: 100%;
    padding: 20px;
    object-fit: contain;
  }

  .favorite-image span {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    background: #080808;
    color: var(--gold);
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .favorite-copy {
    min-height: 180px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .favorite-copy small,
  .brand-copy small {
    color: var(--gold);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .favorite-copy strong {
    margin-top: 8px;
    font-size: 18px;
    line-height: 1.3;
  }

  .favorite-copy b {
    margin-top: 12px;
    font-size: 19px;
  }

  .favorite-copy em {
    margin-top: auto;
    padding-top: 18px;
    color: #a7a7a7;
    font-size: 11px;
    font-style: normal;
    font-weight: 900;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .brand-card {
    min-height: 280px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 20px;
    background:
      linear-gradient(150deg, rgba(212, 175, 55, 0.13), transparent 42%),
      #0b0a08;
    color: #fff;
    display: grid;
    grid-template-rows: 148px 1fr;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .brand-logo-wrap {
    margin: 14px 14px 0;
    padding: 18px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: 14px;
    background: #f4efe3;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-monogram {
    color: #17130a;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 54px;
  }

  .brand-copy {
    min-width: 0;
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
  }

  .brand-copy strong {
    margin-top: 5px;
    font-size: 20px;
    line-height: 1.15;
  }

  .brand-copy span {
    margin-top: 4px;
    color: #929292;
    font-size: 11px;
  }

  .brand-copy b {
    margin-top: auto;
    padding-top: 12px;
    color: var(--gold);
    font-size: 11px;
  }

  .loading-card {
    min-height: 450px;
    border-radius: 24px;
    background: linear-gradient(100deg, #141414 20%, #222 40%, #141414 60%);
    background-size: 200% 100%;
    animation: loading 1.2s ease-in-out infinite;
  }

  .explore-error {
    padding: 26px;
    border: 1px solid rgba(255, 196, 0, 0.35);
    border-radius: 20px;
    background: #151515;
    color: #c8c8c8;
  }

  .hidden { display: none !important; }

  @keyframes loading {
    to { background-position: -200% 0; }
  }

  @media (max-width: 1050px) {
    .favorite-grid,
    .loading-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .brands-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .explore-hero {
      padding: 34px 16px 30px;
    }

    .explore-content {
      padding: 22px 12px 68px;
    }

    .favorite-grid,
    .loading-grid {
      grid-template-columns: 1fr;
    }

    .brands-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .favorite-image {
      height: 310px;
    }

    .brand-card {
      min-height: 238px;
      grid-template-rows: 112px 1fr;
      border-radius: 16px;
    }

    .brand-logo-wrap {
      margin: 9px 9px 0;
      padding: 12px;
      border-radius: 11px;
    }

    .brand-copy {
      padding: 11px 12px 13px;
    }

    .brand-copy small {
      font-size: 8px;
    }

    .brand-copy strong {
      font-size: 16px;
    }

    .brand-copy span,
    .brand-copy b {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorite-card { transition: none; }
    .loading-card { animation: none; }
  }

  /* Nuite luxury polish */
  .explore-page,
  .explore-hero {
    background:
      linear-gradient(180deg, #030303 0%, #090805 52%, #020202 100%);
    color: var(--champagne);
  }

  .explore-hero {
    border-color: rgba(212, 175, 55, 0.18);
  }

  .explore-hero p,
  .favorite-copy small,
  .brand-copy small,
  .brand-copy b {
    color: var(--gold2);
  }

  .explore-hero h1,
  .favorite-copy strong,
  .brand-copy strong {
    color: var(--champagne);
  }

  .explore-hero span,
  .favorite-copy em,
  .brand-copy span {
    color: #bfb49b;
  }

  .favorite-card,
  .brand-card,
  .explore-error {
    border-color: rgba(212, 175, 55, 0.22);
    background:
      linear-gradient(150deg, rgba(212, 175, 55, 0.16), transparent 38%),
      linear-gradient(180deg, #16130c 0%, #070707 70%);
    box-shadow: 0 24px 76px rgba(0, 0, 0, 0.48);
  }

  .favorite-card:hover,
  .brand-card:hover {
    border-color: rgba(241, 216, 137, 0.58);
    box-shadow: 0 30px 88px rgba(0, 0, 0, 0.54), 0 0 34px rgba(212, 175, 55, 0.12);
  }

  .favorite-image {
    background: linear-gradient(145deg, #efe3c4, #b89539 48%, #11100c);
  }

  .favorite-image span {
    border: 1px solid rgba(212, 175, 55, 0.2);
    background: rgba(5, 5, 5, 0.92);
  }

  .favorite-copy b {
    color: var(--gold2);
  }

  .loading-card {
    background: linear-gradient(100deg, #11100c 20%, #2b2412 40%, #11100c 60%);
    background-size: 200% 100%;
  }
</style>
