---
---

<section class="catalogo" id="catalogo">
  <div class="wrap">
    <p class="catalog-kicker">Inventario disponible</p>

    <h2 class="catalog-title">Todos los perfumes</h2>

    <p class="intro">
      Explora fragancias disponibles con información clave como tamaño,
      precio, stock, género y tipo de aroma.
    </p>

    <p class="contador" id="contador">
      Cargando perfumes disponibles...
    </p>

    <div class="filtros">
      <input id="buscador" type="text" placeholder="Buscar perfume..." />

      <div class="fila-filtros">
        <select id="filtroMarca">
          <option value="">Todas las marcas</option>
        </select>

        <select id="filtroGenero">
          <option value="">Todos los géneros</option>
          <option value="Hombre">Hombre</option>
          <option value="Mujer">Mujer</option>
          <option value="Unisex">Unisex</option>
        </select>

        <select id="ordenar">
          <option value="">Ordenar perfumes</option>
          <option value="menor">Precio más bajo</option>
          <option value="mayor">Precio más alto</option>
          <option value="nombre">Orden alfabético</option>
        </select>

        <button id="limpiar" type="button">
          Limpiar filtros
        </button>
      </div>

      <div class="aroma-filtros" aria-label="Filtrar por familia aromática">
        <button class="aroma-chip activo" type="button" data-aroma="">
          Todos
        </button>

        <button class="aroma-chip" type="button" data-aroma="dulce">
          Dulce
        </button>

        <button class="aroma-chip" type="button" data-aroma="amaderada">
          Amaderada
        </button>

        <button class="aroma-chip" type="button" data-aroma="citrica">
          Cítrica
        </button>

        <button class="aroma-chip" type="button" data-aroma="fresca">
          Fresca
        </button>

        <button class="aroma-chip" type="button" data-aroma="floral">
          Floral
        </button>

        <button class="aroma-chip" type="button" data-aroma="frutal">
          Frutal
        </button>

        <button class="aroma-chip" type="button" data-aroma="especiada">
          Especiada
        </button>

        <button class="aroma-chip" type="button" data-aroma="oriental">
          Oriental
        </button>
      </div>
    </div>

    <div class="grid" id="gridPerfumes"></div>

    <p id="sinResultados" class="sin-resultados">
      No se encontraron perfumes con esos filtros.
    </p>

    <div class="paginacion" id="paginacion"></div>
  </div>
</section>

<script>
  import {
    PERFUME_PUBLIC_FIELDS,
    aplicarCorreccionPerfume,
    normalizarNotasPerfume,
  } from "../data/perfumeCorrections";

  const SUPABASE_URL = "https://anawpjjrtxzutillpnoz.supabase.co";
  const SUPABASE_KEY = "sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ";

  const buscador = document.querySelector("#buscador");
  const filtroMarca = document.querySelector("#filtroMarca");
  const filtroGenero = document.querySelector("#filtroGenero");
  const ordenar = document.querySelector("#ordenar");
  const limpiar = document.querySelector("#limpiar");
  const aromaBotones = document.querySelectorAll("[data-aroma]");
  const contador = document.querySelector("#contador");
  const sinResultados = document.querySelector("#sinResultados");
  const paginacion = document.querySelector("#paginacion");
  const grid = document.querySelector("#gridPerfumes");

  let perfumes = [];
  let paginaActual = 1;
  let filtroAroma = "";
  const porPagina = 12;

  const familiasAroma = {
    dulce: [
      "dulce",
      "gourmand",
      "vainilla",
      "avainillado",
      "azucar",
      "caramelo",
      "praline",
      "malvavisco",
      "chocolate",
      "crema",
      "tonka",
    ],
    amaderada: [
      "amaderado",
      "amaderada",
      "madera",
      "cedro",
      "sandalo",
      "vetiver",
      "pachuli",
      "patchouli",
      "oud",
      "cuero",
      "cashmere",
    ],
    citrica: [
      "citrico",
      "citrica",
      "limon",
      "bergamota",
      "mandarina",
      "naranja",
      "pomelo",
      "toronja",
    ],
    fresca: [
      "fresco",
      "fresh",
      "menta",
      "acuatico",
      "acuaticos",
      "limpio",
      "verde",
      "lavanda marina",
    ],
    floral: [
      "floral",
      "flor",
      "jazmin",
      "rosa",
      "gardenia",
      "nardo",
      "orquidea",
      "ylang",
      "geranio",
      "frangipani",
      "violeta",
      "peonia",
    ],
    frutal: [
      "frutal",
      "afrutado",
      "afrutados",
      "fruta",
      "frutas",
      "manzana",
      "pera",
      "mango",
      "frutilla",
      "fresa",
      "cereza",
      "durazno",
      "pina",
      "coco",
      "tropical",
      "bayas",
      "grosella",
      "frambuesa",
    ],
    especiada: [
      "especiado",
      "especiada",
      "calido",
      "pimienta",
      "cardamomo",
      "canela",
      "jengibre",
      "azafran",
      "nuez moscada",
      "romero",
    ],
    oriental: [
      "oriental",
      "ambar",
      "incienso",
      "resina",
      "benzoin",
      "benjui",
      "oud",
      "almizcle",
      "ladano",
    ],
  };

  const formatPrice = (price) =>
    new Intl.NumberFormat("es-CL", {
      style: "currency",
      currency: "CLP",
      maximumFractionDigits: 0,
    }).format(price || 0);

  function imagenPerfume(p) {
    return p.imagen_url || (p.imagen_local ? `/${p.imagen_local}` : "/img/logo.png");
  }

  function detallePerfumeUrl(p) {
    if (p.id) return `/perfume?id=${encodeURIComponent(p.id)}`;
    if (p.slug) return `/perfume?slug=${encodeURIComponent(p.slug)}`;
    return "#";
  }

  function normalizarTexto(valor) {
    return String(valor || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  }

  function textoAromatico(perfume) {
    const notas = normalizarNotasPerfume(perfume.notas);

    return normalizarTexto([
      perfume.tipo_fragancia,
      notas.salida,
      notas.corazon,
      notas.fondo,
      perfume.descripcion,
    ].join(" "));
  }

  function coincideFamiliaAroma(perfume, familia) {
    const palabras = familiasAroma[familia] || [];
    const texto = textoAromatico(perfume);

    return palabras.some((palabra) => texto.includes(palabra));
  }

  function crearCard(p) {
    const article = document.createElement("article");
    article.className = "card perfume-card";
    article.dataset.nombre = (p.nombre || "").toLowerCase();
    article.dataset.marca = p.marca || "";
    article.dataset.genero = p.genero || "";
    article.dataset.fragancia = (p.tipo_fragancia || "").toLowerCase();
    article.dataset.precio = p.precio || 0;

    article.innerHTML = `
      <div class="imgbox">
        <img
          src="${imagenPerfume(p)}"
          alt="${p.nombre || "Perfume"}"
          loading="lazy"
          decoding="async"
        />

        <span class="tag">
          ${p.tipo_fragancia || "Fragancia"}
        </span>

        <div class="size">
          <small>TAMAÑO</small>
          <strong>${p.ml || 100} ml</strong>
        </div>
      </div>

      <div class="body">
        <div class="head">
          <div>
            <h2>${p.nombre || "Perfume sin nombre"}</h2>
            <p class="brand">${p.marca || ""}</p>
          </div>

          <span class="gender">${p.genero || "Unisex"}</span>
        </div>

        <p class="desc">
          ${p.descripcion || "Perfume disponible en Nuite Perfumes."}
        </p>

        <div class="info">
          <div>
            <small>PRECIO</small>
            <strong>${formatPrice(p.precio || 0)}</strong>
          </div>

          <div>
            <small>STOCK</small>
            <strong class="stock">${p.stock || 0} Disponible</strong>
          </div>
        </div>

        <div class="fragancia">
          <small>TIPO DE FRAGANCIA</small>
          <strong>${p.tipo_fragancia || "No especificado"}</strong>
        </div>

        <a class="detalle-boton" href="${detallePerfumeUrl(p)}">
          Ver detalles
        </a>
      </div>
    `;

    return article;
  }

  function cargarMarcas() {
    const marcas = [...new Set(perfumes.map((p) => p.marca).filter(Boolean))];

    filtroMarca.innerHTML = `<option value="">Todas las marcas</option>`;

    marcas.forEach((marca) => {
      const option = document.createElement("option");
      option.value = marca;
      option.textContent = marca;
      filtroMarca.appendChild(option);
    });

    const params = new URLSearchParams(window.location.search);
    const marcaParam = params.get("marca");
    const generoParam = params.get("genero");
    const buscarParam = params.get("buscar");

    if (marcaParam && marcas.includes(marcaParam)) filtroMarca.value = marcaParam;
    if (generoParam) filtroGenero.value = generoParam;
    if (buscarParam) buscador.value = buscarParam;
  }

  function obtenerFiltradas() {
    const texto = buscador.value.toLowerCase().trim();
    const marca = filtroMarca.value;
    const genero = filtroGenero.value;

    let filtradas = perfumes.filter((p) => {
      const nombre = (p.nombre || "").toLowerCase();
      const marcaCard = p.marca || "";
      const generoCard = p.genero || "";
      const fragancia = (p.tipo_fragancia || "").toLowerCase();

      const coincideTexto =
        nombre.includes(texto) ||
        marcaCard.toLowerCase().includes(texto) ||
        fragancia.includes(texto);

      const coincideMarca = !marca || marcaCard === marca;
      const coincideGenero = !genero || generoCard === genero;
      const coincideAroma =
        !filtroAroma || coincideFamiliaAroma(p, filtroAroma);

      return coincideTexto && coincideMarca && coincideGenero && coincideAroma;
    });

    if (ordenar.value === "menor") {
      filtradas.sort((a, b) => Number(a.precio || 0) - Number(b.precio || 0));
    }

    if (ordenar.value === "mayor") {
      filtradas.sort((a, b) => Number(b.precio || 0) - Number(a.precio || 0));
    }

    if (ordenar.value === "nombre") {
      filtradas.sort((a, b) =>
        (a.nombre || "").localeCompare(b.nombre || "")
      );
    }

    return filtradas;
  }

  function renderizar() {
    const filtradas = obtenerFiltradas();
    const totalPaginas = Math.ceil(filtradas.length / porPagina);

    if (paginaActual > totalPaginas) {
      paginaActual = 1;
    }

    grid.innerHTML = "";

    const inicio = (paginaActual - 1) * porPagina;
    const visibles = filtradas.slice(inicio, inicio + porPagina);

    visibles.forEach((p) => {
      grid.appendChild(crearCard(p));
    });

    contador.textContent =
      filtradas.length > 0
        ? `Mostrando ${visibles.length} de ${filtradas.length} perfumes`
        : "No hay perfumes para mostrar";

    sinResultados.style.display = filtradas.length === 0 ? "block" : "none";

    paginacion.innerHTML = "";

    if (totalPaginas <= 1) return;

    for (let i = 1; i <= totalPaginas; i++) {
      const boton = document.createElement("button");
      boton.textContent = i;
      boton.type = "button";

      if (i === paginaActual) {
        boton.classList.add("activo");
      }

      boton.addEventListener("click", () => {
        paginaActual = i;
        renderizar();

        document.querySelector("#catalogo").scrollIntoView({
          behavior: "smooth",
        });
      });

      paginacion.appendChild(boton);
    }
  }

  function resetear() {
    paginaActual = 1;
    renderizar();
  }

  async function cargarPerfumesDesdeSupabase() {
    contador.textContent = "Cargando perfumes disponibles...";

    const parametros = new URLSearchParams({
      select: PERFUME_PUBLIC_FIELDS,
      activo: "eq.true",
      stock: "gt.0",
      order: "nombre.asc",
    });

    try {
      const respuesta = await fetch(
        `${SUPABASE_URL}/rest/v1/perfumes?${parametros}`,
        {
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
          },
        }
      );

      if (!respuesta.ok) throw new Error(`Supabase respondió ${respuesta.status}`);

      const data = await respuesta.json();
      perfumes = (data || []).map(aplicarCorreccionPerfume);
      cargarMarcas();
      renderizar();
    } catch (error) {
      console.error(error);
      contador.textContent = "No se pudo cargar el catálogo.";
    }
  }

  let temporizadorBusqueda;
  buscador.addEventListener("input", () => {
    window.clearTimeout(temporizadorBusqueda);
    temporizadorBusqueda = window.setTimeout(resetear, 120);
  });
  filtroMarca.addEventListener("change", resetear);
  filtroGenero.addEventListener("change", resetear);
  ordenar.addEventListener("change", resetear);

  aromaBotones.forEach((boton) => {
    boton.addEventListener("click", () => {
      filtroAroma = boton.dataset.aroma || "";

      aromaBotones.forEach((item) => {
        item.classList.toggle("activo", item === boton);
      });

      resetear();
    });
  });

  limpiar.addEventListener("click", () => {
    buscador.value = "";
    filtroMarca.value = "";
    filtroGenero.value = "";
    ordenar.value = "";
    filtroAroma = "";

    aromaBotones.forEach((boton) => {
      boton.classList.toggle("activo", boton.dataset.aroma === "");
    });

    paginaActual = 1;
    renderizar();
  });

  window.addEventListener("nuite:buscar", (event) => {
    buscador.value = event.detail || "";
    paginaActual = 1;
    renderizar();
    buscador.focus({ preventScroll: true });
  });

  cargarPerfumesDesdeSupabase();
</script>

<style is:global>
  .discovery,
  .featured-brands {
    padding: 88px 24px;
  }

  .discovery {
    background: #030303;
    color: #111;
  }

  .featured-brands {
    background: #090909;
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .discovery-wrap {
    max-width: 1380px;
    margin: 0 auto;
  }

  .section-heading {
    margin-bottom: 34px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
  }

  .section-kicker {
    margin: 0 0 10px;
    color: #806200;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .section-heading > a {
    color: #111;
    font-size: 13px;
    font-weight: 900;
  }

  .section-heading > a span {
    margin-left: 7px;
    color: #806200;
    font-size: 19px;
  }

  .section-heading-dark .section-kicker {
    color: var(--gold);
  }

  .section-heading-dark > p {
    max-width: 420px;
    margin: 0;
    color: #989898;
    font-size: 14px;
    line-height: 1.6;
  }

  .trend-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(210px, 1fr);
    gap: 16px;
    overflow-x: auto;
    padding: 2px 2px 16px;
    scroll-snap-type: x proximity;
    scrollbar-color: #c9c4b7 transparent;
  }

  .trend-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e1ddd2;
    border-radius: 20px;
    background: #fff;
    color: #111;
    scroll-snap-align: start;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .trend-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgba(40, 33, 10, 0.12);
  }

  .trend-image {
    position: relative;
    height: 260px;
    overflow: hidden;
    background: #f8f8f8;
  }

  .trend-image img {
    width: 100%;
    height: 100%;
    padding: 18px;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .trend-card:hover .trend-image img {
    transform: scale(1.035);
  }

  .trend-image span {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 6px 9px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.88);
    color: #fff;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .trend-body {
    min-height: 142px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .trend-body small {
    color: #877018;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trend-body strong {
    margin-top: 7px;
    display: -webkit-box;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .trend-body b {
    margin-top: auto;
    padding-top: 14px;
    font-size: 17px;
  }

  .trend-skeleton {
    height: 404px;
    border-radius: 20px;
    background: linear-gradient(100deg, #e9e5db 20%, #f4f1ea 40%, #e9e5db 60%);
    background-size: 200% 100%;
    animation: trend-loading 1.2s ease-in-out infinite;
  }

  .section-status {
    margin: 0;
    padding: 24px;
    border: 1px solid currentColor;
    border-radius: 18px;
    color: #777;
    font-size: 14px;
  }

  @keyframes trend-loading {
    to { background-position: -200% 0; }
  }

  .brand-showcase {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .brand-feature {
    position: relative;
    min-height: 510px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 30px;
    background:
      radial-gradient(circle at 50% 32%, rgba(255, 196, 0, 0.2), transparent 34%),
      linear-gradient(150deg, #222, #0e0e0e 58%);
    color: #fff;
    isolation: isolate;
  }

  .brand-feature-2 {
    background:
      linear-gradient(150deg, rgba(212, 175, 55, 0.18), transparent 36%),
      linear-gradient(150deg, #17130a, #0e0e0e 60%);
  }

  .brand-feature-3 {
    background:
      linear-gradient(150deg, rgba(241, 216, 137, 0.16), transparent 36%),
      linear-gradient(150deg, #161207, #0e0e0e 60%);
  }

  .brand-products {
    position: relative;
    height: 335px;
    margin: 24px 20px 0;
  }

  .brand-product {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 54%;
    height: 88%;
    padding: 8px;
    border-radius: 20px;
    background: #fff;
    object-fit: contain;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.38);
    transform: translateX(-50%);
  }

  .brand-product-1 {
    z-index: 3;
  }

  .brand-product-2,
  .brand-product-3 {
    bottom: 14px;
    width: 43%;
    height: 72%;
    opacity: 0.82;
  }

  .brand-product-2 {
    left: 25%;
    transform: translateX(-50%) rotate(-8deg);
  }

  .brand-product-3 {
    left: 75%;
    transform: translateX(-50%) rotate(8deg);
  }

  .brand-feature-copy {
    position: absolute;
    z-index: 5;
    right: 20px;
    bottom: 20px;
    left: 20px;
    padding: 18px 20px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(5, 5, 5, 0.92);
    backdrop-filter: blur(10px);
  }

  .brand-feature-copy span {
    color: var(--gold);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .brand-feature-copy strong {
    grid-column: 1;
    font-size: 24px;
    line-height: 1.1;
  }

  .brand-feature-copy small {
    grid-column: 1;
    margin-top: 3px;
    color: #9b9b9b;
    font-size: 11px;
  }

  .brand-feature-copy b {
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: center;
    color: #fff;
    font-size: 11px;
  }

  .catalogo {
    background: #000;
    min-height: 100vh;
    padding: 42px 24px 70px;
    color: white;
  }

  .wrap {
    max-width: 1380px;
    margin: 0 auto;
  }

  .catalog-kicker {
    margin: 0;
    color: #ffc400;
    font-weight: 900;
    letter-spacing: 0.25em;
    font-size: 11px;
    text-transform: uppercase;
  }

  .catalog-title {
    font-size: clamp(38px, 5vw, 58px);
    margin: 16px 0 10px;
    font-weight: 1000;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .intro {
    color: #b7b7b7;
    font-size: 18px;
    max-width: 760px;
    line-height: 1.7;
  }

  .contador {
    color: #cfcfcf;
    font-weight: 900;
    margin-top: 48px;
    margin-bottom: 24px;
  }

  .filtros {
    background: #171717;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 30px;
    padding: 24px;
    margin-bottom: 56px;
  }

  .filtros input {
    width: 100%;
    height: 62px;
    border-radius: 17px;
    border: none;
    background: #000;
    color: white;
    padding: 0 24px;
    font-size: 18px;
    outline: none;
    margin-bottom: 18px;
  }

  .fila-filtros {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 280px;
    gap: 16px;
  }

  .fila-filtros select,
  .fila-filtros button {
    width: 100%;
    height: 58px;
    border-radius: 16px;
    border: none;
    padding: 0 22px;
