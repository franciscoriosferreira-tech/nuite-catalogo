---
---

<section class="catalogo" id="catalogo">
  <div class="wrap">
    <p class="catalog-kicker">Inventario disponible</p>

    <h2 class="catalog-title">Todos los perfumes</h2>

    <p class="intro">
      Explora fragancias disponibles con información clave como tamaño,
      precio, stock, género y tipo de aroma.
    </p>

    <p class="contador" id="contador">
      Cargando perfumes disponibles...
    </p>

    <div class="filtros">
      <div class="filtro-principal">
        <label class="sr-only" for="buscador">Buscar perfume</label>
        <input id="buscador" type="search" placeholder="Buscar perfume..." autocomplete="off" />

        <button
          id="alternarFiltros"
          class="filtros-toggle"
          type="button"
          aria-controls="filtrosAvanzados"
          aria-expanded="false"
        >
          <span>Filtros</span>
          <span id="filtrosActivos" class="filtros-activos" hidden>0</span>
          <span class="filtros-toggle-mark" aria-hidden="true"></span>
        </button>
      </div>

      <div id="filtrosAvanzados" class="filtros-avanzados">
        <div class="fila-filtros">
          <select id="filtroMarca" aria-label="Filtrar por marca">
            <option value="">Todas las marcas</option>
          </select>

          <select id="filtroGenero" aria-label="Filtrar por género">
            <option value="">Todos los géneros</option>
            <option value="Hombre">Hombre</option>
            <option value="Mujer">Mujer</option>
            <option value="Unisex">Unisex</option>
          </select>

          <select id="ordenar" aria-label="Ordenar perfumes">
            <option value="">Ordenar perfumes</option>
            <option value="menor">Precio más bajo</option>
            <option value="mayor">Precio más alto</option>
            <option value="nombre">Orden alfabético</option>
          </select>

          <button id="limpiar" type="button">
            Limpiar filtros
          </button>
        </div>
      </div>

      <div class="aroma-filtros" aria-label="Filtrar por familia aromática">
        <button class="aroma-chip activo" type="button" data-aroma="">
          Todos
        </button>

        <button class="aroma-chip" type="button" data-aroma="dulce">
          Dulce
        </button>

        <button class="aroma-chip" type="button" data-aroma="amaderada">
          Amaderada
        </button>

        <button class="aroma-chip" type="button" data-aroma="citrica">
          Cítrica
        </button>

        <button class="aroma-chip" type="button" data-aroma="fresca">
          Fresca
        </button>

        <button class="aroma-chip" type="button" data-aroma="floral">
          Floral
        </button>

        <button class="aroma-chip" type="button" data-aroma="frutal">
          Frutal
        </button>

        <button class="aroma-chip" type="button" data-aroma="especiada">
          Especiada
        </button>

        <button class="aroma-chip" type="button" data-aroma="oriental">
          Oriental
        </button>
      </div>
    </div>

    <div class="grid" id="gridPerfumes"></div>

    <p id="sinResultados" class="sin-resultados">
      No se encontraron perfumes con esos filtros.
    </p>

    <div class="paginacion" id="paginacion"></div>
  </div>
</section>

<script>
  import {
    PERFUME_PUBLIC_FIELDS,
    aplicarCorreccionPerfume,
  } from "../data/perfumeCorrections";
  import {
    coincideBusquedaPerfume,
    coincideFamiliaAroma,
    coincideValorExacto,
    normalizarTextoFiltro,
  } from "../data/perfumeFilters";

  const SUPABASE_URL = "https://anawpjjrtxzutillpnoz.supabase.co";
  const SUPABASE_KEY = "sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ";

  const buscador = document.querySelector("#buscador");
  const filtroMarca = document.querySelector("#filtroMarca");
  const filtroGenero = document.querySelector("#filtroGenero");
  const ordenar = document.querySelector("#ordenar");
  const limpiar = document.querySelector("#limpiar");
  const alternarFiltros = document.querySelector("#alternarFiltros");
  const filtrosAvanzados = document.querySelector("#filtrosAvanzados");
  const filtrosActivos = document.querySelector("#filtrosActivos");
  const aromaBotones = document.querySelectorAll("[data-aroma]");
  const contador = document.querySelector("#contador");
  const sinResultados = document.querySelector("#sinResultados");
  const paginacion = document.querySelector("#paginacion");
  const grid = document.querySelector("#gridPerfumes");

  let perfumes = [];
  let paginaActual = 1;
  let filtroAroma = "";
  const porPagina = 12;

  const formatPrice = (price) =>
    new Intl.NumberFormat("es-CL", {
      style: "currency",
      currency: "CLP",
      maximumFractionDigits: 0,
    }).format(price || 0);

  function imagenPerfume(p) {
    return p.imagen_url || (p.imagen_local ? `/${p.imagen_local}` : "/img/logo.png");
  }

  function detallePerfumeUrl(p) {
    if (p.id) return `/perfume?id=${encodeURIComponent(p.id)}`;
    if (p.slug) return `/perfume?slug=${encodeURIComponent(p.slug)}`;
    return "#";
  }

  function crearCard(p) {
    const article = document.createElement("article");
    article.className = "card perfume-card";
    article.dataset.nombre = (p.nombre || "").toLowerCase();
    article.dataset.marca = p.marca || "";
    article.dataset.genero = p.genero || "";
    article.dataset.fragancia = (p.tipo_fragancia || "").toLowerCase();
    article.dataset.precio = p.precio || 0;

    article.innerHTML = `
      <div class="imgbox">
        <img
          src="${imagenPerfume(p)}"
          alt="${p.nombre || "Perfume"}"
          loading="lazy"
          decoding="async"
        />

        <span class="tag">
          ${p.tipo_fragancia || "Fragancia"}
        </span>

        <div class="size">
          <small>TAMAÑO</small>
          <strong>${p.ml || 100} ml</strong>
        </div>
      </div>

      <div class="body">
        <div class="head">
          <div>
            <h2>${p.nombre || "Perfume sin nombre"}</h2>
            <p class="brand">${p.marca || ""}</p>
          </div>

          <span class="gender">${p.genero || "Unisex"}</span>
        </div>

        <p class="desc">
          ${p.descripcion || "Perfume disponible en Nuite Perfumes."}
        </p>

        <div class="info">
          <div>
            <small>PRECIO</small>
            <strong>${formatPrice(p.precio || 0)}</strong>
          </div>

          <div>
            <small>STOCK</small>
            <strong class="stock">${p.stock || 0} Disponible</strong>
          </div>
        </div>


        <a class="detalle-boton" href="${detallePerfumeUrl(p)}">
          Ver detalles
        </a>
      </div>
    `;

    return article;
  }

  function cargarMarcas() {
    const marcas = [...new Set(perfumes.map((p) => String(p.marca || "").trim()).filter(Boolean))]
      .sort((a, b) => a.localeCompare(b, "es"));

    filtroMarca.innerHTML = `<option value="">Todas las marcas</option>`;

    marcas.forEach((marca) => {
      const option = document.createElement("option");
      option.value = marca;
      option.textContent = marca;
      filtroMarca.appendChild(option);
    });

    const params = new URLSearchParams(window.location.search);
    const marcaParam = params.get("marca");
    const generoParam = params.get("genero");
    const buscarParam = params.get("buscar");

    const marcaCoincidente = marcas.find(
      (marca) => normalizarTextoFiltro(marca) === normalizarTextoFiltro(marcaParam)
    );
    const generoCoincidente = ["Hombre", "Mujer", "Unisex"].find(
      (genero) => normalizarTextoFiltro(genero) === normalizarTextoFiltro(generoParam)
    );

    if (marcaCoincidente) filtroMarca.value = marcaCoincidente;
    if (generoCoincidente) filtroGenero.value = generoCoincidente;
    if (buscarParam) buscador.value = buscarParam;
  }

  function obtenerFiltradas() {
    const texto = buscador.value;
    const marca = filtroMarca.value;
    const genero = filtroGenero.value;

    let filtradas = perfumes.filter((p) => {
      const coincideTexto = coincideBusquedaPerfume(p, texto);
      const coincideMarca = coincideValorExacto(p.marca, marca);
      const coincideGenero = coincideValorExacto(p.genero, genero);
      const coincideAroma = coincideFamiliaAroma(p, filtroAroma);

      return coincideTexto && coincideMarca && coincideGenero && coincideAroma;
    });

    if (ordenar.value === "menor") {
      filtradas.sort((a, b) => Number(a.precio || 0) - Number(b.precio || 0));
    }

    if (ordenar.value === "mayor") {
      filtradas.sort((a, b) => Number(b.precio || 0) - Number(a.precio || 0));
    }

    if (ordenar.value === "nombre") {
      filtradas.sort((a, b) =>
        (a.nombre || "").localeCompare(b.nombre || "")
      );
    }

    return filtradas;
  }

  function actualizarEstadoFiltros() {
    const total = [
      buscador.value.trim(),
      filtroMarca.value,
      filtroGenero.value,
      ordenar.value,
      filtroAroma,
    ].filter(Boolean).length;

    filtrosActivos.textContent = String(total);
    filtrosActivos.hidden = total === 0;
    limpiar.disabled = total === 0;
  }

  function renderizar() {
    const filtradas = obtenerFiltradas();
    const totalPaginas = Math.ceil(filtradas.length / porPagina);

    actualizarEstadoFiltros();

    if (paginaActual > totalPaginas) {
      paginaActual = 1;
    }

    grid.innerHTML = "";

    const inicio = (paginaActual - 1) * porPagina;
    const visibles = filtradas.slice(inicio, inicio + porPagina);

    visibles.forEach((p) => {
      grid.appendChild(crearCard(p));
    });

    contador.textContent =
      filtradas.length > 0
        ? `Mostrando ${visibles.length} de ${filtradas.length} perfumes`
        : "No hay perfumes para mostrar";

    sinResultados.style.display = filtradas.length === 0 ? "block" : "none";

    paginacion.innerHTML = "";

    if (totalPaginas <= 1) return;

    for (let i = 1; i <= totalPaginas; i++) {
      const boton = document.createElement("button");
      boton.textContent = i;
      boton.type = "button";
      boton.setAttribute("aria-label", "Ir a la página " + i);

      if (i === paginaActual) {
        boton.classList.add("activo");
        boton.setAttribute("aria-current", "page");
      }

      boton.addEventListener("click", () => {
        paginaActual = i;
        renderizar();

        grid.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      });

      paginacion.appendChild(boton);
    }
  }

  function resetear() {
    paginaActual = 1;
    renderizar();
  }

  async function cargarPerfumesDesdeSupabase() {
    contador.textContent = "Cargando perfumes disponibles...";

    const parametros = new URLSearchParams({
      select: PERFUME_PUBLIC_FIELDS,
      activo: "eq.true",
      stock: "gt.0",
      order: "nombre.asc",
    });

    try {
      const respuesta = await fetch(
        `${SUPABASE_URL}/rest/v1/perfumes?${parametros}`,
        {
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
          },
        }
      );

      if (!respuesta.ok) throw new Error(`Supabase respondió ${respuesta.status}`);

      const data = await respuesta.json();
      perfumes = (data || []).map(aplicarCorreccionPerfume);
      cargarMarcas();
      renderizar();
    } catch (error) {
      console.error(error);
      contador.textContent = "No se pudo cargar el catálogo.";
    }
  }

  alternarFiltros.addEventListener("click", () => {
    const abierto = filtrosAvanzados.classList.toggle("abiertos");
    alternarFiltros.setAttribute("aria-expanded", String(abierto));
  });

  let temporizadorBusqueda;
  buscador.addEventListener("input", () => {
    window.clearTimeout(temporizadorBusqueda);
    temporizadorBusqueda = window.setTimeout(resetear, 120);
  });
  filtroMarca.addEventListener("change", resetear);
  filtroGenero.addEventListener("change", resetear);
  ordenar.addEventListener("change", resetear);

  aromaBotones.forEach((boton) => {
    boton.addEventListener("click", () => {
      filtroAroma = boton.dataset.aroma || "";

      aromaBotones.forEach((item) => {
        item.classList.toggle("activo", item === boton);
      });

      resetear();
    });
  });

  limpiar.addEventListener("click", () => {
    buscador.value = "";
    filtroMarca.value = "";
    filtroGenero.value = "";
    ordenar.value = "";
    filtroAroma = "";

    aromaBotones.forEach((boton) => {
      boton.classList.toggle("activo", boton.dataset.aroma === "");
    });

    paginaActual = 1;
    filtrosAvanzados.classList.remove("abiertos");
    alternarFiltros.setAttribute("aria-expanded", "false");
    renderizar();
  });

  window.addEventListener("nuite:buscar", (event) => {
    buscador.value = event.detail || "";
    paginaActual = 1;
    renderizar();
    buscador.focus({ preventScroll: true });
  });

  cargarPerfumesDesdeSupabase();
</script>

<style is:global>
  .catalogo {
    min-height: 100vh;
    padding: 38px 24px 80px;
    background: linear-gradient(180deg, #030303 0%, #090805 48%, #020202 100%);
    color: var(--champagne);
  }

  .catalogo .wrap {
    max-width: 1380px;
    margin: 0 auto;
  }

  .catalog-kicker {
    margin: 0;
    color: var(--gold2);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .catalog-title {
    margin: 12px 0 8px;
    color: var(--champagne);
    font-size: clamp(38px, 5vw, 58px);
    font-weight: 1000;
    line-height: 1;
    letter-spacing: 0;
  }

  .intro {
    max-width: 720px;
    margin: 0;
    color: #c4b99f;
    font-size: 17px;
    line-height: 1.6;
  }

  .contador {
    margin: 32px 0 16px;
    color: #bdb29a;
    font-size: 15px;
    font-weight: 900;
  }

  .filtros {
    margin-bottom: 34px;
    padding: 18px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgba(212, 175, 55, 0.07), transparent 52%),
      #0d0c09;
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.36);
  }

  .filtro-principal {
    display: grid;
    grid-template-columns: 1fr;
  }

  .filtros input,
  .fila-filtros select {
    width: 100%;
    height: 50px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 13px;
    outline: 0;
    background: #050505;
    color: var(--champagne);
    font: inherit;
    font-size: 15px;
  }

  .filtros input {
    padding: 0 18px;
  }

  .filtros input::placeholder {
    color: #8f856f;
  }

  .filtros input:focus,
  .fila-filtros select:focus {
    border-color: rgba(241, 216, 137, 0.62);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.12);
  }

  .filtros-toggle {
    display: none;
  }

  .filtros-avanzados {
    margin-top: 12px;
  }

  .fila-filtros {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr minmax(180px, 220px);
    gap: 10px;
  }

  .fila-filtros select {
    padding: 0 15px;
  }

  .fila-filtros button {
    min-height: 50px;
    border: 0;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
    font: inherit;
    font-size: 14px;
    font-weight: 1000;
    cursor: pointer;
  }

  .fila-filtros button:disabled {
    opacity: 0.48;
    cursor: default;
  }

  .aroma-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(212, 175, 55, 0.14);
  }

  .aroma-chip {
    min-height: 38px;
    padding: 0 15px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 999px;
    background: #080806;
    color: #d8cfb8;
    font: inherit;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .aroma-chip:hover {
    color: #fff;
    border-color: rgba(241, 216, 137, 0.58);
    transform: translateY(-1px);
  }

  .aroma-chip.activo {
    border-color: var(--gold);
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
    box-shadow: 0 0 18px rgba(212, 175, 55, 0.18);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    scroll-margin-top: 190px;
  }

  .card {
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(212, 175, 55, 0.06), transparent 38%),
      #0d0c09;
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.38);
    content-visibility: auto;
    contain-intrinsic-size: 560px;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(241, 216, 137, 0.5);
    box-shadow: 0 24px 68px rgba(0, 0, 0, 0.48), 0 0 26px rgba(212, 175, 55, 0.1);
  }

  .imgbox {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(145deg, #efe2c2 0%, #b9963a 42%, #100f0b 100%);
  }

  .imgbox img {
    width: 100%;
    height: 100%;
    padding: 20px;
    object-fit: contain;
    background: transparent;
  }

  .tag {
    position: absolute;
    top: 14px;
    left: 14px;
    max-width: calc(100% - 28px);
    overflow: hidden;
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
    font-size: 11px;
    font-weight: 1000;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .size {
    position: absolute;
    right: 14px;
    bottom: 14px;
    min-width: 82px;
    padding: 10px 13px;
    border: 1px solid rgba(212, 175, 55, 0.17);
    border-radius: 15px;
    background: rgba(6, 6, 5, 0.92);
    text-align: center;
  }

  .size small,
  .perfume-card small {
    display: block;
    color: #817966;
    font-size: 10px;
    letter-spacing: 0;
  }

  .size strong {
    display: block;
    margin-top: 3px;
    color: var(--gold2);
    font-size: 19px;
    line-height: 1;
  }

  .body {
    padding: 21px;
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .perfume-card h2 {
    margin: 0;
    color: var(--champagne);
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .perfume-card .brand {
    margin: 6px 0 0;
    color: var(--gold2);
    font-size: 16px;
    font-weight: 900;
  }

  .gender {
    flex: 0 0 auto;
    padding: 6px 11px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 999px;
    background: #080806;
    color: #d8cfb8;
    font-size: 11px;
    white-space: nowrap;
  }

  .desc {
    display: -webkit-box;
    min-height: 2.9em;
    margin: 15px 0;
    overflow: hidden;
    color: #bdb29a;
    font-size: 14px;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    border-bottom: 1px solid rgba(212, 175, 55, 0.14);
  }

  .info > div {
    min-width: 0;
    padding: 12px 4px;
  }

  .info > div + div {
    padding-left: 15px;
    border-left: 1px solid rgba(212, 175, 55, 0.14);
  }

  .info strong {
    display: block;
    margin-top: 5px;
    color: var(--champagne);
    font-size: 16px;
    overflow-wrap: anywhere;
  }

  .stock {
    color: var(--gold2) !important;
  }

  .detalle-boton {
    width: 100%;
    height: 48px;
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
    font-size: 14px;
    font-weight: 1000;
    text-decoration: none;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .detalle-boton:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .sin-resultados {
    display: none;
    margin-top: 28px;
    padding: 22px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 18px;
    background: #0d0c09;
    color: #cfc6b1;
    text-align: center;
    font-weight: 900;
  }

  .paginacion {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
  }

  .paginacion button {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 13px;
    background: #080806;
    color: #d8cfb8;
    font: inherit;
    font-size: 15px;
    font-weight: 900;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .paginacion button:hover {
    border-color: rgba(241, 216, 137, 0.52);
    transform: translateY(-1px);
  }

  .paginacion button.activo {
    border-color: var(--gold);
    background: linear-gradient(135deg, var(--gold2), var(--gold) 54%, #9c741b);
    color: #050505;
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.2);
  }

