---
import { createClient } from '@supabase/supabase-js';
import Layout from '../../layouts/Layout.astro';
import Navegacion from '../../components/Navegacion.astro';

export async function getStaticPaths() {
  const supabase = createClient(
    'https://anawpjjrtxzutillpnoz.supabase.co',
    'sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ'
  );

  const { data } = await supabase
    .from('perfumes')
    .select('slug')
    .eq('activo', true);

  return (data || [])
    .filter((perfume) => perfume.slug)
    .map((perfume) => ({
      params: {
        slug: String(perfume.slug),
      },
    }));
}

const supabase = createClient(
  'https://anawpjjrtxzutillpnoz.supabase.co',
  'sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ'
);

const { slug } = Astro.params;

const { data: perfume } = await supabase
  .from('perfumes')
  .select('*')
  .eq('slug', slug)
  .eq('activo', true)
  .single();

const formatPrice = (price) =>
  new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  }).format(price || 0);

const imagen =
  perfume?.imagen_url ||
  (perfume?.imagen_local
    ? `/${perfume.imagen_local}`
    : "/img/logo.png");

const notas = perfume?.notas || {};
---

<Layout title={perfume ? `${perfume.nombre} | Nuite Perfumes` : "Perfume no encontrado"}>
  <Navegacion />

  {
    perfume ? (
      <main class="detalle">
        <div class="wrap">

          <a href="/#catalogo" class="volver">
            ← Volver al catálogo
          </a>

          <section class="grid-detalle">

            <div class="foto">
              <img src={imagen} alt={perfume.nombre} />
            </div>

            <div class="info">

              <p class="marca">
                {perfume.marca}
              </p>

              <h1>
                {perfume.nombre}
              </h1>

              <p class="descripcion">
                {perfume.descripcion || "Perfume disponible en Nuite Perfumes."}
              </p>

              <div class="notas">

                <h2>
                  NOTAS OLFATIVAS
                </h2>

                <div class="notas-grid">

                  <div>
                    <span>SALIDA</span>
                    <strong>
                      {notas.salida || "No especificado"}
                    </strong>
                  </div>

                  <div>
                    <span>CORAZÓN</span>
                    <strong>
                      {notas.corazon || "No especificado"}
                    </strong>
                  </div>

                  <div>
                    <span>FONDO</span>
                    <strong>
                      {notas.fondo || "No especificado"}
                    </strong>
                  </div>

                </div>

              </div>

              <div class="precioBox">
                <span>PRECIO</span>

                <strong>
                  {formatPrice(perfume.precio || perfume.precio_sugerido)}
                </strong>
              </div>

              <div class="datos">

                <div>
                  <span>TAMAÑO</span>
                  <strong>{perfume.ml || 100} ml</strong>
                </div>

                <div>
                  <span>GÉNERO</span>
                  <strong>{perfume.genero || "Unisex"}</strong>
                </div>

                <div>
                  <span>FRAGANCIA</span>
                  <strong>
                    {perfume.tipo_fragancia || "No especificado"}
                  </strong>
                </div>

                <div>
                  <span>STOCK</span>

                  <strong class={Number(perfume.stock || 0) > 0 ? "stock ok" : "stock no"}>
                    {Number(perfume.stock || 0) > 0
                      ? `${perfume.stock} Disponible`
                      : "Agotado"}
                  </strong>
                </div>

              </div>

              <a
                class="whatsapp"
                target="_blank"
                href={`https://wa.me/56935226409?text=${encodeURIComponent(
                  `Hola, quiero comprar ${perfume.nombre} de ${perfume.marca}`
                )}`}
              >
                Comprar por WhatsApp
              </a>

            </div>

          </section>

        </div>
      </main>
    ) : (
      <main class="detalle">
        <div class="wrap">

          <a href="/#catalogo" class="volver">
            ← Volver al catálogo
          </a>

          <div class="not-found">
            <h1>Perfume no encontrado</h1>

            <p>
              Este perfume no existe, está agotado o fue desactivado.
            </p>
          </div>

        </div>
      </main>
    )
  }
</Layout>

<style>
  .detalle {
    background: #000;
    min-height: 100vh;
    color: white;
    padding: 34px 22px 60px;
  }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
  }

  .volver {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--gold);
    font-weight: 900;
    font-size: 15px;
  }

  .grid-detalle {
    display: grid;
    grid-template-columns: .85fr 1fr;
    gap: 38px;
    align-items: start;
  }

  .foto {
    border-radius: 24px;
    overflow: hidden;
    background: #111;
  }

  .foto img {
    width: 100%;
    height: 580px;
    object-fit: cover;
  }

  .marca {
    color: var(--gold);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 5px;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(34px, 4vw, 50px);
    margin: 0;
    line-height: 1;
    font-weight: 1000;
    text-shadow: 2px 2px 0 rgba(0,120,255,.35);
  }

  .descripcion {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.55;
    margin: 18px 0 22px;
  }

  .notas {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 22px;
    margin-bottom: 24px;
  }

  .notas h2 {
    margin: 0 0 16px;
    color: var(--gold);
    letter-spacing: 5px;
    font-size: 14px;
  }

  .notas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .notas-grid div,
  .datos div {
    background: #070707;
    border-radius: 15px;
    padding: 16px;
  }

  span {
    display: block;
    color: #888;
    font-size: 11px;
    margin-bottom: 8px;
  }

  strong {
    font-size: 15px;
    line-height: 1.45;
  }

  .precioBox {
    margin-bottom: 20px;
  }

  .precioBox strong {
    display: block;
    color: var(--gold);
    font-size: 38px;
    line-height: 1;
  }

  .datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .datos div {
    background: var(--card);
    border: 1px solid var(--border);
  }

  .stock.ok {
    color: #00e69a;
  }

  .stock.no {
    color: #ff5b5b;
  }

  .whatsapp {
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--gold);
    color: #000;
    padding: 16px 22px;
    border-radius: 16px;
    font-size: 15px;
    font-weight: 1000;
    width: fit-content;
    min-width: 280px;
    margin: 0 auto;
    transition: .25s;
  }

  .whatsapp:hover {
    transform: translateY(-2px);
    background: #ffd84d;
  }

  .not-found {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 32px;
  }

  @media (max-width: 950px) {
    .grid-detalle {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .foto img {
      height: 430px;
    }

    .notas-grid,
    .datos {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .detalle {
      padding: 22px 14px 48px;
    }

    .foto img {
      height: 340px;
    }

    .notas {
      padding: 16px;
    }

    .precioBox strong {
      font-size: 32px;
    }

    .whatsapp {
      width: 100%;
      min-width: unset;
    }
  }
</style>