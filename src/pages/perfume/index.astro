---
import Layout from '../../layouts/Layout.astro';
import Navegacion from '../../components/Navegacion.astro';
---

<Layout title="Detalle perfume | Nuite Perfumes">
  <Navegacion />

  <main class="detalle">
    <div class="wrap">
      <a href="/#catalogo" class="volver">
        Volver al catalogo
      </a>

      <div id="estadoCarga" class="not-found">
        <h1>Cargando perfume...</h1>
        <p>Estamos buscando la informacion actualizada del producto.</p>
      </div>

      <section id="detallePerfume" class="grid-detalle oculto">
        <div class="foto">
          <img
            id="imagenPerfume"
            src="/img/logo.png"
            alt="Perfume"
            decoding="async"
          />
        </div>

        <div class="info">
          <p id="marcaPerfume" class="marca"></p>

          <h1 id="nombrePerfume"></h1>

          <p id="descripcionPerfume" class="descripcion"></p>

          <details id="notesDetails" class="notas" open>
            <summary>NOTAS OLFATIVAS</summary>

            <div class="notas-grid">
              <div>
                <span>SALIDA</span>
                <strong id="notaSalida">No especificado</strong>
              </div>

              <div>
                <span>CORAZÓN</span>
                <strong id="notaCorazon">No especificado</strong>
              </div>

              <div>
                <span>FONDO</span>
                <strong id="notaFondo">No especificado</strong>
              </div>
            </div>
          </details>

          <div class="precioBox">
            <span>PRECIO</span>
            <strong id="precioPerfume">$0</strong>
          </div>

          <div class="datos">
            <div>
              <span>TAMAÑO</span>
              <strong id="tamanoPerfume">100 ml</strong>
            </div>

            <div>
              <span>GÉNERO</span>
              <strong id="generoPerfume">Unisex</strong>
            </div>

            <div>
              <span>FRAGANCIA</span>
              <strong id="fraganciaPerfume">No especificado</strong>
            </div>

            <div>
              <span>STOCK</span>
              <strong id="stockPerfume" class="stock ok">Disponible</strong>
            </div>
          </div>

          <section class="rating-box" aria-labelledby="ratingTitle">
            <div>
              <span id="ratingTitle">TU CALIFICACIÓN</span>
              <strong>¿Qué te pareció este perfume?</strong>
            </div>
            <div id="ratingStars" class="rating-stars" role="radiogroup" aria-label="Calificar perfume de 1 a 5 estrellas">
              {[1, 2, 3, 4, 5].map((value) => (
                <button type="button" data-rating={value} aria-label={`${value} estrella${value === 1 ? "" : "s"}`} aria-checked="false" role="radio">★</button>
              ))}
            </div>
            <small id="ratingMessage">Selecciona de 1 a 5 estrellas.</small>
          </section>

          <section class="purchase-panel" aria-label="Opciones de compra">
            <div class="purchase-row">
              <div class="quantity-control" aria-label="Cantidad">
                <button id="quantityMinus" type="button" aria-label="Disminuir cantidad">−</button>
                <input id="productQuantity" type="number" min="1" value="1" inputmode="numeric" aria-label="Cantidad de unidades" />
                <button id="quantityPlus" type="button" aria-label="Aumentar cantidad">+</button>
              </div>
              <button id="addProductToCart" class="add-cart" type="button">Agregar al carrito</button>
            </div>
            <p id="purchaseSubtotal" class="purchase-subtotal"></p>
            <a id="whatsappPerfume" class="whatsapp" target="_blank" rel="noreferrer">
              Comprar por WhatsApp
            </a>
            <p id="purchaseMessage" class="purchase-message" role="status" aria-live="polite"></p>

            <div class="purchase-details">
              <details>
                <summary><span aria-hidden="true">🚚</span> Envío a domicilio</summary>
                <p>Realizamos envíos a regiones de Chile. El valor y el plazo se confirman según la comuna y la empresa de transporte antes del despacho. Te enviaremos los datos de seguimiento cuando el pedido sea entregado al transportista.</p>
              </details>
              <details>
                <summary><span aria-hidden="true">⌖</span> Retiro en Río Bueno</summary>
                <p>El retiro se coordina directamente con Nuité en Río Bueno. El lugar y el horario se acuerdan por WhatsApp después de confirmar la compra.</p>
              </details>
              <details>
                <summary><span aria-hidden="true">↩</span> Cambios y devoluciones</summary>
                <p>Para cambios voluntarios o retracto cuando corresponda, el perfume debe mantenerse sin uso, sellado, con su celofán y embalaje original en perfecto estado. Por higiene y seguridad no recibimos perfumes abiertos, probados o con sellos retirados. Si el producto presenta una falla, daño de origen o no corresponde a lo comprado, se respetará íntegramente la garantía legal vigente. Contáctanos dentro de los 10 días siguientes a la recepción para revisar solicitudes de retracto aplicables.</p>
                <a href="/politicas">Ver política completa</a>
              </details>
            </div>
          </section>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { createClient } from "@supabase/supabase-js";
    import {
      PERFUME_PUBLIC_FIELDS,
      aplicarCorreccionPerfume,
      normalizarNotasPerfume,
    } from "../../data/perfumeCorrections";
    import { addToCart, readCart } from "../../scripts/cart";

    const supabase = createClient(
      "https://anawpjjrtxzutillpnoz.supabase.co",
      "sb_publishable_s9BoS3q6FoCAHZ9BdPgH3g_uuR7UtNZ"
    );

    const $ = (selector) => document.querySelector(selector);
    let currentPerfume = null;
    let selectedQuantity = 1;

    $("#notesDetails")?.toggleAttribute(
      "open",
      !window.matchMedia("(max-width: 520px)").matches
    );

    const formatPrice = (price) =>
      new Intl.NumberFormat("es-CL", {
        style: "currency",
        currency: "CLP",
        maximumFractionDigits: 0,
      }).format(price || 0);

    function obtenerReferenciaPerfume() {
      const params = new URLSearchParams(window.location.search);
      const idQuery = params.get("id");
      const slugQuery = params.get("slug");

      if (idQuery) return { id: idQuery, slug: "" };
      if (slugQuery) return { id: "", slug: slugQuery };

      const slugRuta = window.location.pathname
        .replace(/^\/perfume\/?/, "")
        .replace(/\/$/, "");

      return { id: "", slug: decodeURIComponent(slugRuta || "") };
    }

    function imagenPerfume(perfume) {
      return perfume.imagen_url ||
        (perfume.imagen_local ? `/${perfume.imagen_local}` : "/img/logo.png");
    }

    function getPrice(perfume) {
      return Number(perfume?.precio || perfume?.precio_sugerido || 0);
    }

    function showPurchaseMessage(message, isError = false) {
      const box = $("#purchaseMessage");
      box.textContent = message;
      box.classList.toggle("error", isError);
    }

    function updateWhatsappLink() {
      if (!currentPerfume) return;
      const total = getPrice(currentPerfume) * selectedQuantity;
      $("#purchaseSubtotal").textContent = `${selectedQuantity} ${selectedQuantity === 1 ? "unidad" : "unidades"} · Total ${formatPrice(total)}`;
      $("#whatsappPerfume").href = `https://wa.me/56935226409?text=${encodeURIComponent(
        `Hola Nuité, quiero comprar ${selectedQuantity} ${selectedQuantity === 1 ? "unidad" : "unidades"} de ${currentPerfume.nombre || "este perfume"} de ${currentPerfume.marca || "Nuité"}. Total productos: ${formatPrice(total)}.`
      )}`;
    }

    function setQuantity(value, reportLimit = true) {
      if (!currentPerfume) return;
      const stock = Number(currentPerfume.stock || 0);
      const requested = Math.max(1, Math.floor(Number(value) || 1));

      if (requested > stock) {
        if (reportLimit) showPurchaseMessage(`No hay suficiente stock. Actualmente hay ${stock} ${stock === 1 ? "unidad disponible" : "unidades disponibles"}.`, true);
        selectedQuantity = Math.max(1, stock);
      } else {
        selectedQuantity = requested;
        showPurchaseMessage("");
      }

      $("#productQuantity").value = String(stock > 0 ? selectedQuantity : 0);
      $("#quantityMinus").disabled = stock === 0 || selectedQuantity <= 1;
      $("#quantityPlus").disabled = stock === 0 || selectedQuantity >= stock;
      updateWhatsappLink();
    }

    function renderRating(perfumeId) {
      const key = `nuite-rating-${perfumeId}`;
      const saved = Number(localStorage.getItem(key) || 0);
      $("#ratingStars").querySelectorAll("button").forEach((button) => {
        const value = Number(button.dataset.rating);
        button.classList.toggle("active", value <= saved);
        button.setAttribute("aria-checked", String(value === saved));
      });
      $("#ratingMessage").textContent = saved
        ? `Guardamos tu calificación: ${saved} de 5 estrellas.`
        : "Selecciona de 1 a 5 estrellas.";
    }

    function mostrarEstado(titulo, texto) {
      $("#detallePerfume").classList.add("oculto");
      $("#estadoCarga").classList.remove("oculto");
      $("#estadoCarga").innerHTML = `
        <h1>${titulo}</h1>
        <p>${texto}</p>
      `;
    }

    function renderPerfume(perfume) {
      const notas = normalizarNotasPerfume(perfume.notas);
      const stock = Number(perfume.stock || 0);
      const imagen = imagenPerfume(perfume);
      currentPerfume = perfume;
      selectedQuantity = stock > 0 ? 1 : 0;

      document.title = `${perfume.nombre || "Perfume"} | Nuite Perfumes`;

      $("#estadoCarga").classList.add("oculto");
      $("#detallePerfume").classList.remove("oculto");

      $("#imagenPerfume").src = imagen;
      $("#imagenPerfume").alt = perfume.nombre || "Perfume";
      $("#imagenPerfume").onerror = () => {
        $("#imagenPerfume").src = "/img/logo.png";
      };

      $("#marcaPerfume").textContent = perfume.marca || "";
      $("#nombrePerfume").textContent = perfume.nombre || "Perfume sin nombre";
      $("#descripcionPerfume").textContent =
        perfume.descripcion || "Perfume disponible en Nuite Perfumes.";
      $("#notaSalida").textContent = notas.salida || "No especificado";
      $("#notaCorazon").textContent = notas.corazon || "No especificado";
      $("#notaFondo").textContent = notas.fondo || "No especificado";
      $("#precioPerfume").textContent =
        formatPrice(perfume.precio || perfume.precio_sugerido);
      $("#tamanoPerfume").textContent = `${perfume.ml || 100} ml`;
      $("#generoPerfume").textContent = perfume.genero || "Unisex";
      $("#fraganciaPerfume").textContent =
        perfume.tipo_fragancia || "No especificado";

      const stockPerfume = $("#stockPerfume");
      stockPerfume.textContent =
        stock > 0 ? `${stock} Disponible` : "Agotado";
      stockPerfume.className = stock > 0 ? "stock ok" : "stock no";

      $("#productQuantity").max = String(stock);
      $("#productQuantity").disabled = stock === 0;
      $("#addProductToCart").disabled = stock === 0;
      $("#whatsappPerfume").setAttribute("aria-disabled", String(stock === 0));
      if (stock === 0) $("#whatsappPerfume").removeAttribute("href");
      setQuantity(stock > 0 ? 1 : 0, false);
      renderRating(perfume.id);
    }

    $("#quantityMinus").addEventListener("click", () => setQuantity(selectedQuantity - 1));
    $("#quantityPlus").addEventListener("click", () => setQuantity(selectedQuantity + 1));
    $("#productQuantity").addEventListener("input", (event) => setQuantity(event.currentTarget.value));

    $("#addProductToCart").addEventListener("click", () => {
      if (!currentPerfume) return;
      const stock = Number(currentPerfume.stock || 0);
      const alreadyInCart = readCart().find((item) => item.id === currentPerfume.id)?.quantity || 0;
      if (alreadyInCart + selectedQuantity > stock) {
        showPurchaseMessage(`No hay suficiente stock. Ya tienes ${alreadyInCart} en el carrito y quedan ${stock} unidades en total.`, true);
        return;
      }
      addToCart({
        id: currentPerfume.id,
        name: currentPerfume.nombre || "Perfume",
        brand: currentPerfume.marca || "Nuité Perfumes",
        image: imagenPerfume(currentPerfume),
        price: getPrice(currentPerfume),
        stock,
      }, selectedQuantity);
      showPurchaseMessage(`${selectedQuantity} ${selectedQuantity === 1 ? "unidad agregada" : "unidades agregadas"} al carrito.`);
    });

    $("#ratingStars").addEventListener("click", (event) => {
      const button = event.target.closest("button[data-rating]");
      if (!button || !currentPerfume) return;
      localStorage.setItem(`nuite-rating-${currentPerfume.id}`, button.dataset.rating);
      renderRating(currentPerfume.id);
    });

    async function cargarPerfume() {
      const referencia = obtenerReferenciaPerfume();

      if (!referencia.id && !referencia.slug) {
        mostrarEstado(
          "Perfume no encontrado",
          "Vuelve al catalogo y selecciona un producto disponible."
        );
        return;
      }

      let query = supabase
        .from("perfumes")
        .select(PERFUME_PUBLIC_FIELDS)
        .eq("activo", true);

      if (referencia.id) {
        query = query.eq("id", referencia.id);
      } else {
        query = query.eq("slug", referencia.slug);
      }

      const { data, error } = await query
        .limit(1)
        .maybeSingle();

      if (error) {
        console.error(error);
        mostrarEstado(
          "No se pudo cargar el perfume",
          "Intenta recargar la pagina en unos segundos."
        );
        return;
      }

      if (!data) {
        mostrarEstado(
          "Perfume no encontrado",
          "Este perfume no existe, esta agotado o fue desactivado."
        );
        return;
      }

      renderPerfume(aplicarCorreccionPerfume(data));
    }

    cargarPerfume();
  </script>

  <style>
    .detalle {
      background: #000;
      min-height: 100vh;
      color: white;
      padding: 34px 22px 60px;
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
    }

    .oculto {
      display: none !important;
    }

    .volver {
      display: inline-flex;
      margin-bottom: 28px;
      color: var(--gold);
      font-weight: 900;
      font-size: 15px;
    }

    .grid-detalle {
      display: grid;
      grid-template-columns: .85fr 1fr;
      gap: 38px;
      align-items: start;
    }

    .foto {
      border-radius: 24px;
      overflow: hidden;
      background: #111;
    }

    .foto img {
      width: 100%;
      height: 580px;
      object-fit: cover;
    }

    .marca {
      color: var(--gold);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 5px;
      text-transform: uppercase;
      margin: 0 0 12px;
    }

    h1 {
      font-size: clamp(34px, 4vw, 50px);
      margin: 0;
      line-height: 1;
      font-weight: 1000;
      text-shadow: 0 14px 42px rgba(212,175,55,.14);
    }

    .descripcion {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.55;
      margin: 18px 0 22px;
    }

    .notas {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 22px;
      margin-bottom: 24px;
    }

    .notas summary {
      margin: 0 0 16px;
      color: var(--gold);
      letter-spacing: 5px;
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      list-style: none;
    }

    .notas summary::-webkit-details-marker { display: none; }
    .notas summary::after { content: "−"; float: right; color: var(--gold2); font-size: 18px; letter-spacing: 0; }
    .notas:not([open]) summary { margin-bottom: 0; }
    .notas:not([open]) summary::after { content: "+"; }

    .notas-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .notas-grid div,
    .datos div {
      background: #070707;
      border-radius: 15px;
      padding: 16px;
    }

    span {
      display: block;
      color: #888;
      font-size: 11px;
      margin-bottom: 8px;
    }

    strong {
      font-size: 15px;
      line-height: 1.45;
    }

    .precioBox {
      margin-bottom: 20px;
    }

    .precioBox strong {
      display: block;
      color: var(--gold);
      font-size: 38px;
      line-height: 1;
    }

    .datos {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .datos div {
      background: var(--card);
      border: 1px solid var(--border);
    }

    .stock.ok {
      color: #00e69a;
    }

    .stock.no {
      color: #ff5b5b;
    }

    .whatsapp {
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--gold);
      color: #000;
      padding: 16px 22px;
      border-radius: 16px;
      font-size: 15px;
      font-weight: 1000;
      width: 100%;
      margin: 10px 0 0;
      transition: .25s;
    }

    .whatsapp:hover {
      transform: translateY(-2px);
      background: #ffd84d;
    }

    .whatsapp[aria-disabled="true"] {
      opacity: .45;
      pointer-events: none;
    }

    .rating-box {
      margin-bottom: 20px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: #0c0b09;
    }

    .rating-box > div:first-child span { margin-bottom: 5px; }
    .rating-box small { color: #8d8575; line-height: 1.4; }
    .rating-stars { display: flex; gap: 3px; }
    .rating-stars button {
      padding: 2px;
      border: 0;
      background: transparent;
      color: #4f493e;
      font-size: 27px;
      line-height: 1;
      cursor: pointer;
    }
    .rating-stars button.active,
    .rating-stars button:hover { color: var(--gold2); }

    .purchase-panel {
      padding: 20px;
      border: 1px solid var(--gold-border);
      border-radius: 22px;
      background: linear-gradient(145deg, rgba(212,175,55,.08), transparent 42%), #0d0c0a;
    }

    .purchase-row { display: grid; grid-template-columns: 170px 1fr; gap: 12px; }
    .quantity-control {
      height: 50px;
      display: grid;
      grid-template-columns: 48px 1fr 48px;
      overflow: hidden;
      border: 1px solid var(--gold-border);
      border-radius: 13px;
      background: #050505;
    }
    .quantity-control button,
    .quantity-control input {
      min-width: 0;
      border: 0;
      background: transparent;
      color: #fff;
      font: inherit;
      font-weight: 900;
      text-align: center;
    }
    .quantity-control button { color: var(--gold2); font-size: 22px; cursor: pointer; }
    .quantity-control button:disabled { opacity: .28; cursor: not-allowed; }
    .quantity-control input { width: 100%; appearance: textfield; }
    .quantity-control input::-webkit-inner-spin-button { appearance: none; }
    .add-cart {
      min-height: 50px;
      border: 1px solid var(--gold2);
      border-radius: 13px;
      background: transparent;
      color: var(--champagne);
      font: inherit;
      font-weight: 1000;
      cursor: pointer;
    }
    .add-cart:hover { background: rgba(212,175,55,.09); }
    .add-cart:disabled { opacity: .4; cursor: not-allowed; }
    .purchase-subtotal { margin: 11px 0 0; color: #aaa18e; font-size: 12px; text-align: right; }
    .purchase-message { min-height: 18px; margin: 9px 0 0; color: #7ee0af; font-size: 12px; line-height: 1.45; }
    .purchase-message.error { color: #ff8585; }
    .purchase-details { margin-top: 18px; border-top: 1px solid rgba(255,255,255,.09); }
    .purchase-details details { border-bottom: 1px solid rgba(255,255,255,.09); }
    .purchase-details summary {
      padding: 17px 3px;
      display: flex;
      align-items: center;
      gap: 11px;
      color: var(--champagne);
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      list-style: none;
    }
    .purchase-details summary::-webkit-details-marker { display: none; }
    .purchase-details summary::after { content: "+"; margin-left: auto; color: var(--gold2); font-size: 20px; }
    .purchase-details details[open] summary::after { content: "−"; }
    .purchase-details summary span { margin: 0; color: var(--gold2); font-size: 18px; }
    .purchase-details p { margin: -2px 3px 15px; color: #9d9585; font-size: 13px; line-height: 1.65; }
    .purchase-details a { display: inline-flex; margin: -2px 3px 17px; color: var(--gold2); font-size: 12px; font-weight: 900; }

    .not-found {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
    }

    @media (max-width: 950px) {
      .grid-detalle {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .foto img {
        height: 430px;
      }

      .notas-grid,
      .datos {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 520px) {
      .detalle {
        padding: 16px 12px 42px;
      }

      .volver { margin-bottom: 14px; font-size: 12px; }
      .grid-detalle { gap: 18px; }

      .foto img {
        height: 255px;
      }

      .foto { border-radius: 17px; }
      .info { display:flex;flex-direction:column; }
      .marca { margin-bottom: 7px; font-size: 10px; letter-spacing: 3px; }
      .marca { order:1; }
      h1 { font-size: 31px; }
      .info > h1 { order:2; }
      .descripcion { margin: 10px 0 14px; font-size: 13px; }
      .descripcion { order:3; }

      .notas {
        order:8;
        margin: 14px 0 0;
        padding: 13px;
        border-radius: 16px;
      }

      .notas summary { margin-bottom: 10px; font-size: 11px; letter-spacing: 3px; }
      .notas:not([open]) summary { margin-bottom:0; }
      .notas-grid { display:grid;grid-template-columns:1fr;gap:8px;overflow:visible }
      .notas-grid div{padding:12px}

      .precioBox strong {
        font-size: 29px;
      }

      .precioBox { order:4;margin-bottom:13px; }
      .datos { order:5;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:15px }
      .datos div{padding:12px}.datos strong{font-size:13px}

      .whatsapp {
        width: 100%;
      }

      .rating-box { order:7;margin:12px 0 0;padding:13px;display:grid;grid-template-columns:1fr auto;gap:8px;border-radius:14px }
      .rating-box>div:first-child strong{font-size:12px}.rating-box small{grid-column:1/-1}.rating-stars button{font-size:23px}
      .purchase-panel{order:6;padding:13px;border-radius:16px}
      .purchase-row { grid-template-columns: 126px 1fr; gap:8px }
      .quantity-control{height:45px;grid-template-columns:38px 1fr 38px}.add-cart{min-height:45px;font-size:12px}
      .whatsapp{min-height:45px;padding:10px 14px;border-radius:11px;font-size:13px}
      .purchase-details{margin-top:12px}.purchase-details summary{padding:14px 2px;font-size:12px}.purchase-details p{font-size:12px}
      .purchase-subtotal { text-align: left; }
    }
  </style>
</Layout>
