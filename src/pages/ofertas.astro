---
import Layout from "../layouts/Layout.astro";
import Navegacion from "../components/Navegacion.astro";
---

<Layout title="Ofertas | Nuite Perfumes">
  <Navegacion />

  <section class="pagina">
    <div class="contenedor center">
      <p class="kicker">PROMOCIONES DISPONIBLES</p>

      <h1>Ofertas</h1>

      <div class="card">
        <h2>Próximamente tendremos ofertas disponibles</h2>

        <p>
          Aquí aparecerán promociones, descuentos y perfumes seleccionados
          cuando estén activos.
        </p>

        <a href="/#catalogo" class="btn">
          Volver al catálogo
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pagina {
    min-height: 100vh;
    background: #000;
    color: white;
    padding: 70px 22px;
  }

  .contenedor {
    max-width: 1000px;
    margin: 0 auto;
  }

  .center {
    text-align: center;
  }

  .kicker {
    color: #ffc400;
    font-weight: 900;
    letter-spacing: 6px;
    font-size: 13px;
  }

  h1 {
    margin: 14px 0 0;
    font-size: 52px;
    font-weight: 1000;
  }

  .card {
    margin-top: 48px;
    background: #171717;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 30px;
    padding: 42px;
  }

  h2 {
    color: #ffc400;
    font-size: 28px;
    margin: 0;
  }

  p {
    color: #b7b7b7;
    line-height: 1.7;
    margin-top: 18px;
  }

  .btn {
    margin-top: 28px;
    display: inline-flex;
    background: #ffc400;
    color: #000;
    padding: 16px 24px;
    border-radius: 16px;
    font-weight: 1000;
    text-decoration: none;
  }
</style>