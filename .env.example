# Supabase (solo servidor)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Flow. Mantener FLOW_ENV=sandbox hasta validar todo el circuito.
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=

# URL publica sin slash final. En local, usa un tunel HTTPS para probar callbacks.
PUBLIC_SITE_URL=https://tu-dominio.cl

# Correos transaccionales. Para Gmail usa una contraseña de aplicación de 16 caracteres,
# nunca la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nuiteperfumes@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Nuité Perfumes
ORDER_NOTIFICATION_EMAIL=nuiteperfumes@gmail.com
ORDER_ADMIN_URL=https://nuite-admin.vercel.app/admin/pedidos
